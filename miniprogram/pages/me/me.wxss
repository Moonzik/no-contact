/* pages/me/me.wxss */

.me {
  padding: 100rpx 40rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  min-height: 100vh;
  position: relative;
  /* v0.9.2：右上角齿轮取消，顶部不需要再为它留空 */
  padding-top: calc(56rpx + env(safe-area-inset-top));
}

/* ── 身份卡 ───────────────────────────── */
.me-head {
  display: flex;
  align-items: center;
  gap: 28rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}
.head-hover { background: #fdfaf3; }

/* v0.8.1：image 组件默认 320×240，作为 flex item 时 height:100% 不一定生效，
   结果就是「正圆容器里装了个 4:3 的图」→ 看起来是椭圆。
   改成父级 relative + 图片绝对定位铺满，彻底锁死正方形。 */
.ava-wrap {
  position: relative;
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  border: 3rpx solid var(--ink);
  box-sizing: border-box;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--bg);
}
.ava {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.ava-ph {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  font-family: var(--serif);
  font-size: 44rpx;
  color: var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.me-id { flex: 1; min-width: 0; }
.me-id .nick {
  font-family: var(--serif);
  font-size: 36rpx;
  letter-spacing: 4rpx;
  text-indent: 4rpx; /* 抵消 letter-spacing 造成的居中偏移 */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.me-id .nick-off {
  color: var(--accent);
  font-size: 31rpx;
}
.me-id .sub {
  font-size: 24rpx;
  color: var(--faint);
  margin-top: 8rpx;
  letter-spacing: 3rpx;
  text-indent: 3rpx;
}
.chev {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid var(--faint);
  border-right: 3rpx solid var(--faint);
  transform: rotate(45deg);
  flex-shrink: 0;
  margin-right: 6rpx;
}

/* ── 卡片 ───────────────────────────── */
.me-card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  padding: 6rpx 32rpx;
  margin-bottom: 24rpx;
}
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
  min-height: 100rpx;
  box-sizing: border-box;
}
.row:last-child { border-bottom: none; }
.row-hover { opacity: 0.6; }
.row .l { font-size: 28rpx; }
.row .l small {
  display: block;
  font-size: 23rpx;
  color: var(--faint);
  margin-top: 4rpx;
  letter-spacing: 1rpx;
}
.me-input {
  border: none;
  background: transparent;
  text-align: right;
  outline: none;
  color: var(--accent);
  font-size: 28rpx;
  max-width: 55%;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0;
}
.picker-r {
  border: none;
  background: transparent;
}
.picker-v {
  color: var(--accent);
  font-size: 28rpx;
  padding: 4rpx 0;
}
.row-go {
  font-size: 27rpx;
  color: var(--accent);
  letter-spacing: 2rpx;
  text-indent: 2rpx;
  flex-shrink: 0;
  padding: 12rpx 4rpx 12rpx 24rpx;
}
.row-go-danger { color: var(--danger); }

.me-foot {
  text-align: center;
  color: var(--faint);
  font-size: 21rpx;
  letter-spacing: 4rpx;
  text-indent: 4rpx; /* 抵消 letter-spacing 造成的居中偏移 */
  margin-top: 40rpx;
}

/* v0.9.2 · 关于内容平铺在页面上（不再藏在右上角齿轮弹层里） */
.about-card {
  padding: 32rpx 32rpx;
}
.about-head {
  font-family: var(--serif);
  font-size: 32rpx;
  letter-spacing: 4rpx;
  text-indent: 4rpx; /* 抵消 letter-spacing 造成的偏移 */
  margin-bottom: 18rpx;
}
.about-line {
  font-size: 25rpx;
  color: var(--sub);
  line-height: 1.9;
  letter-spacing: 1rpx;
}
/* AI 引擎状态：一眼确认接没接上大模型 */
.ai-line-card {
  color: var(--accent);
  margin-top: 2rpx;
  margin-bottom: 4rpx;
}

/* 隐私指引入口：审核要求小程序内可触达，
   v0.9.2 起并入「关于断联日记」卡片，用一条上分隔线和上面的文字分开 */
.row-sep {
  border-top: 1rpx solid var(--line);
  margin-top: 16rpx;
}

/* 危机求助：页面级展示，加上下间距 */
.crisis {
  background: #fbf3ee;
  border: 1rpx solid #ead8cb;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  font-size: 25rpx;
  color: #9a5d3a;
  line-height: 1.85;
  margin-bottom: 32rpx;
}
.crisis b { color: #7a3a1e; }
.crisis-note {
  font-size: 22rpx;
  color: #a89284;
  margin: 6rpx 0 4rpx;
}

/* ── 弹层 ───────────────────────────── */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(38, 35, 30, 0.45);
  z-index: 80;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.sheet {
  width: 100%;
  background: var(--bg);
  border-radius: 32rpx 32rpx 0 0;
  padding: 48rpx 48rpx calc(56rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  max-height: 90vh;
  overflow-y: auto;
  animation: slideUp 0.25s ease;
}
@keyframes slideUp {
  from { transform: translateY(60rpx); opacity: 0.4; }
  to { transform: none; opacity: 1; }
}
.sheet .h {
  font-family: var(--serif);
  font-size: 36rpx;
  letter-spacing: 6rpx;
  text-indent: 6rpx;
  margin-bottom: 36rpx;
}
.sheet-p {
  font-size: 26rpx;
  color: var(--sub);
  line-height: 1.8;
  margin-bottom: 36rpx;
}
.sheet-p-danger { color: var(--danger); }

/* 头像选择（button open-type="chooseAvatar" 必须做样式重置）
   v0.9.7：不再用「wrap 定尺寸 + button 100% 铺满」——真机上微信 button
   的默认盒样式可能把百分比尺寸撑变形（表现为椭圆）。
   改为尺寸直接写死在 button 上（184rpx 正方形 + !important 压默认样式），
   子元素用 flex 居中、普通流布局，圆裁切交给 button 的 overflow:hidden。 */
.ava-pick-wrap {
  display: flex;
  justify-content: center;
  margin: 0 auto 24rpx;
}
.ava-pick {
  display: flex !important;
  align-items: center;
  justify-content: center;
  width: 184rpx !important;
  height: 184rpx !important;
  max-width: 184rpx !important;
  min-width: 184rpx !important;
  max-height: 184rpx !important;
  min-height: 184rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  border-radius: 50%;
  background: var(--card);
  border: 1rpx dashed var(--line);
  box-sizing: border-box;
  overflow: hidden;
  line-height: 1;
  flex: none;
  font-size: 24rpx;
  color: var(--faint);
}
.ava-pick::after { display: none; }
.ava-pick-img {
  width: 184rpx;
  height: 184rpx;
  border-radius: 50%;
  flex: none;
}
.ava-pick-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  text-indent: 2rpx;
}

/* 昵称：input 必须显式给 height + line-height，否则文字会被 padding 顶出可视区 */
.nick-input {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  box-sizing: border-box;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  text-align: center;
  margin-bottom: 20rpx;
}
/* v0.8.1 · 微信头像点不动时的兜底入口（做成正式按钮，别藏成小字） */
.ava-alt {
  display: block;
  text-align: center;
  font-size: 25rpx;
  color: var(--accent);
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  padding: 18rpx 24rpx;
  margin: 0 auto 32rpx;
  width: fit-content;
  max-width: 100%;
  box-sizing: border-box;
}
.ava-alt-hover { background: #fdfaf3; }

.tip {
  font-size: 23rpx;
  color: var(--faint);
  text-align: center;
  line-height: 1.7;
  margin-bottom: 36rpx;
  letter-spacing: 1rpx;
}
.logout-link {
  display: block;
  text-align: center;
  color: var(--faint);
  font-size: 25rpx;
  letter-spacing: 2rpx;
  text-indent: 2rpx;
  margin-top: 32rpx;
  padding: 12rpx 0;
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

