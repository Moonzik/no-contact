<view class="me">

  <!-- 身份卡：未登录显示「点击登录」，已登录显示头像 + 昵称 -->
  <view class="me-head" bindtap="onEditProfile" hover-class="head-hover">
    <view class="ava-wrap">
      <image class="ava" src="{{avatar}}" mode="aspectFill" wx:if="{{avatar}}" />
      <view class="ava ava-ph" wx:else>{{day}}</view>
    </view>
    <view class="me-id">
      <view class="nick {{logged ? '' : 'nick-off'}}">
        {{logged ? nick : '点击登录 · 用微信头像昵称'}}
      </view>
      <view class="sub">断联第 {{day}} 天{{logged ? '' : ' · 登录后可打卡、聊天'}}</view>
    </view>
    <view class="chev"></view>
  </view>

  <!-- 戒断设置 -->
  <view class="me-card">
    <view class="row">
      <view class="l">
        戒断开始日
        <small>计数从这天起</small>
      </view>
      <picker mode="date" value="{{startDate}}" bindchange="onPickDate" class="picker-r">
        <view class="picker-v">{{startDate}}</view>
      </picker>
    </view>
    <view class="row">
      <view class="l">
        TA 的代号
        <small>只存在你的手机里</small>
      </view>
      <input class="me-input" value="{{exName}}" placeholder="可留空"
             placeholder-style="color:#b8b1a4"
             bindblur="onExInput" />
    </view>
    <view class="row" bindtap="onReminder" hover-class="row-hover">
      <view class="l">
        每日提醒
        <small>{{reminderOn ? '已订阅，微信会叫你回来打卡' : '到点提醒你回来打卡'}}</small>
      </view>
      <view class="row-go">{{reminderOn ? '已开' : '去开'}}</view>
    </view>
    <view class="row" bindtap="onNewSegment" hover-class="row-hover">
      <view class="l">
        开始新的一段
        <small>换一个人，或干净地重新开始</small>
      </view>
      <view class="row-go">开始</view>
    </view>
    <view class="row" wx:if="{{segCount > 0}}" bindtap="onShowSegs" hover-class="row-hover">
      <view class="l">
        过往记录
        <small>{{segCount}} 段走过的路</small>
      </view>
      <view class="row-go">查看</view>
    </view>
  </view>

  <!-- 数据 -->
  <view class="me-card">
    <view class="row" bindtap="onExport" hover-class="row-hover">
      <view class="l">
        导出数据
        <small>复制为 JSON 备份</small>
      </view>
      <view class="row-go">导出</view>
    </view>
    <view class="row" bindtap="onImportBackup" hover-class="row-hover">
      <view class="l">
        导入备份
        <small>换手机 / 重装后恢复</small>
      </view>
      <view class="row-go">导入</view>
    </view>
    <view class="row" wx:if="{{prevExists}}" bindtap="onImportUndo" hover-class="row-hover">
      <view class="l">
        撤销上次导入
        <small>回到导入之前的那份数据</small>
      </view>
      <view class="row-go">撤销</view>
    </view>
    <view class="row" bindtap="onClear" hover-class="row-hover">
      <view class="l">
        清空所有数据
        <small>不可恢复</small>
      </view>
      <view class="row-go row-go-danger">清空</view>
    </view>
  </view>

  <!-- 关于 / 隐私 / 求助：v0.9.2 取消右上角齿轮，全部直接平铺在页面上 -->
  <view class="me-card about-card">
    <view class="about-head">关于断联日记</view>
    <view class="about-line">断联日记 NOEX · v{{version}}</view>
    <view class="about-line ai-line-card">{{aiText}}</view>
    <view class="about-line">断联记录、留白瓶只存在你的手机里。只有你在对话里主动发送的内容，会用于生成回复。</view>
    <view class="about-line">本产品不替代专业帮助，也不提供任何服务性质的陪伴。</view>

    <view class="row row-sep" bindtap="onOpenAgreement" hover-class="row-hover">
      <view class="l">
        用户服务协议
        <small>我们各自的责任边界</small>
      </view>
      <view class="row-go">查看</view>
    </view>

    <view class="row row-sep" bindtap="onOpenFeedback" hover-class="row-hover">
      <view class="l">
        意见反馈
        <small>遇到问题 · 想加功能</small>
      </view>
      <view class="row-go">反馈</view>
    </view>

    <view class="row row-sep" bindtap="onOpenPrivacy" hover-class="row-hover">
      <view class="l">
        用户隐私保护指引
        <small>你的数据怎么存 · 是否共享给 AI</small>
      </view>
      <view class="row-go">查看</view>
    </view>
  </view>

  <!-- v0.9.14 · 运行记录：只在真的有异常记录时才渲染。
       一切正常的用户永远看不到这一块——它出现的本身就是"出过事"的信号，
       所以文案刻意不吓人：不写「错误」「崩溃」，写「运行记录」。 -->
  <view class="me-card" wx:if="{{errCount > 0}}">
    <view class="row" bindtap="onShowErrs" hover-class="row-hover">
      <view class="l">
        运行记录
        <small>记下了 {{errCount}} 次异常，复制发我能帮我定位</small>
      </view>
      <view class="row-go">查看</view>
    </view>
  </view>

  <!-- 危机求助方式：不折叠、不藏在弹层里。
       下面的号码是国家级公益求助渠道，不是本小程序提供的服务，
       标注清楚是为了避免被误判为「本产品提供心理服务」。 -->
  <view class="crisis">
    <b>遇到危机时，请让真实的人现在陪着你</b>
    <view class="crisis-note">以下是国家公益求助渠道，不由本小程序提供</view>
    <view>· 全国 24 小时心理援助热线：400-161-9995</view>
    <view>· 北京心理危机研究与干预中心：010-82951332</view>
    <view>· 紧急情况请直接拨打 120 / 110</view>
  </view>

  <view class="me-foot">愿你断得干净，把时间留给自己</view>

  <!-- 登录 / 编辑资料 -->
  <view class="mask" wx:if="{{showLogin}}" bindtap="onProfileClose">
    <view class="sheet" catchtap="noop">
      <view class="h">{{logged ? '编辑资料' : '微信一键登录'}}</view>

      <!-- 头像：外层固定正方形 + 内层铺满，锁死正圆（以前 button 会被拉成椭圆） -->
      <view class="ava-pick-wrap">
        <block wx:if="{{avaSupported}}">
          <button class="ava-pick" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar"
                  bindtap="onAvatarTap" binderror="onAvatarError" hover-class="none">
            <image class="ava-pick-img" src="{{tmpAvatar}}" mode="aspectFill" wx:if="{{tmpAvatar}}" />
            <view class="ava-pick-img ava-pick-ph" wx:else>选微信头像</view>
          </button>
        </block>
        <!-- 低版本/模拟器/隐私未授权时降级：从相册选，保证一定点得动 -->
        <block wx:else>
          <button class="ava-pick" bindtap="onPickAvatarAlbum" hover-class="none">
            <image class="ava-pick-img" src="{{tmpAvatar}}" mode="aspectFill" wx:if="{{tmpAvatar}}" />
            <view class="ava-pick-img ava-pick-ph" wx:else>选头像</view>
          </button>
        </block>
      </view>

      <!-- 兜底入口：微信头像那颗按钮如果点不动（模拟器 / 隐私指引未配置 / 基础库问题），这里一定行 -->
      <view class="ava-alt" bindtap="onPickAvatarAlbum" hover-class="ava-alt-hover">
        {{devtools ? '模拟器里请用这个从相册选头像' : '选微信头像没反应？点这里从相册选'}}
      </view>

      <!-- 昵称：支持 type="nickname" 的基础库，聚焦时微信自动带出昵称 -->
      <input wx:if="{{nickSupported}}" class="nick-input" type="nickname"
             value="{{tmpNick}}"
             placeholder="点这里填入微信昵称"
             placeholder-style="color:#b8b1a4"
             maxlength="16"
             bindinput="onNickInput" />
      <input wx:else class="nick-input" type="text"
             value="{{tmpNick}}"
             placeholder="给自己起个名字"
             placeholder-style="color:#b8b1a4"
             maxlength="16"
             bindinput="onNickInput" />

      <!-- 手机号：微信一键填写。
           v0.9.8：主体已变更为个体工商户，可以正常使用 getPhoneNumber。
           拿不到时不阻塞登录——手机号是选填项，手填照样能用。 -->
      <view class="field-row">
        <input class="phone-input" type="number"
               value="{{tmpPhone}}"
               placeholder="手机号（选填）"
               placeholder-style="color:#b8b1a4"
               maxlength="11"
               bindinput="onPhoneInput" />
        <button wx:if="{{phoneSupported}}" class="phone-btn" open-type="getPhoneNumber"
                bindgetphonenumber="onGetPhoneNumber" hover-class="phone-btn-hover">一键填写</button>
      </view>
      <view class="phone-hint" wx:if="{{!phoneSupported}}">
        当前微信版本不支持一键填写，可手动填写（选填）
      </view>

      <view class="tip">头像、昵称和手机号只保存在你自己的手机里，不会上传。</view>

      <button class="btn btn-primary" bindtap="onProfileSave">{{logged ? '保存' : '登录'}}</button>
      <button class="btn btn-ghost" style="margin-top:16rpx;" bindtap="onProfileClose">取消</button>
      <view class="logout-link" wx:if="{{logged}}" bindtap="onLogoutAsk">退出登录</view>
    </view>
  </view>

  <!-- 退出登录确认 -->
  <view class="mask" wx:if="{{showLogout}}" bindtap="onLogoutCancel">
    <view class="sheet" catchtap="noop">
      <view class="h">退出登录？</view>
      <view class="sheet-p">头像和昵称会被移除，戒断记录不受影响。</view>
      <button class="btn btn-primary" bindtap="onLogoutConfirm">退出登录</button>
      <button class="btn btn-ghost" style="margin-top:16rpx;" bindtap="onLogoutCancel">取消</button>
    </view>
  </view>

  <!-- 清空确认 -->
  <view class="mask" wx:if="{{showClear}}" bindtap="onClearCancel">
    <view class="sheet" catchtap="noop">
      <view class="h">清空所有数据？</view>
      <view class="sheet-p sheet-p-danger">
        戒断记录、对话、留白瓶、影子设置都会被删除，无法恢复。
      </view>
      <button class="btn btn-primary" style="background:var(--danger);margin-bottom:20rpx;" bindtap="onClearConfirm">确认清空</button>
      <button class="btn btn-ghost" bindtap="onClearCancel">取消</button>
    </view>
  </view>

  <!-- v0.9.13 导入备份：先校验并展示摘要，用户确认后才真的覆盖 -->
  <view class="mask" wx:if="{{showImport}}" bindtap="onCloseImport">
    <view class="sheet" catchtap="noop">
      <view class="h">导入备份</view>
      <view class="sheet-p">
        备份是一段文字（导出时复制过）。先把来源选一下，我会先核对内容，
        确认是你自己的备份才会覆盖当前数据。
      </view>

      <button class="btn btn-primary" bindtap="onImportFromClipboard">从剪贴板导入</button>
      <button class="btn btn-ghost" style="margin-top:16rpx;" bindtap="onImportFromFile">从聊天选文件</button>

      <!-- 校验失败 -->
      <view class="imp-err" wx:if="{{importErr}}">{{importErr}}</view>

      <!-- 校验通过：先让用户看清楚要覆盖进来的是什么 -->
      <view class="imp-sum" wx:if="{{importSummary}}">
        <view class="imp-t">核对一下这份备份</view>
        <view class="imp-line">开始于 {{importSummary.startDate}}</view>
        <view class="imp-line">打卡 {{importSummary.checkCount}} 次 · 断过 {{importSummary.relapseCount}} 次</view>
        <view class="imp-line">对话 {{importSummary.msgCount}} 条 · 留白瓶 {{importSummary.bottleCount}} 句 · 日记 {{importSummary.diaryCount}} 天</view>
        <view class="imp-line" wx:if="{{importSummary.segmentCount > 0}}">过往 {{importSummary.segmentCount}} 段</view>
        <view class="imp-line" wx:if="{{importSummary.hasUser}}">含登录信息（头像 / 昵称）</view>
        <view class="imp-warn">导入会覆盖你现在的数据。导入前我会自动存一份快照，事后可以「撤销上次导入」。</view>
        <button class="btn btn-primary" style="margin-top:24rpx;" bindtap="onImportConfirm">确认导入</button>
      </view>

      <button class="btn btn-ghost" style="margin-top:16rpx;" bindtap="onCloseImport">关闭</button>
    </view>
  </view>

  <!-- v0.9.13 开始新的一段 -->
  <view class="mask" wx:if="{{showNewSeg}}" bindtap="onCloseNewSeg">
    <view class="sheet" catchtap="noop">
      <view class="h">开始新的一段？</view>
      <view class="sheet-p">
        打卡天数、打卡次数、断联日历都从今天从零开始，TA 的代号清空，
        影子的模仿也要重新导入聊天记录（他认的是人）。
      </view>
      <view class="sheet-p">
        日记、留白瓶、和小白的对话都保留——那些是你自己的东西，不属于某一个人。
        现在这一段会存进「过往记录」，随时能回看。
      </view>
      <button class="btn btn-primary" bindtap="onNewSegmentConfirm">开始新的一段</button>
      <button class="btn btn-ghost" style="margin-top:16rpx;" bindtap="onCloseNewSeg">先不了</button>
    </view>
  </view>

  <!-- v0.9.13 过往记录 -->
  <view class="mask" wx:if="{{showSegs}}" bindtap="onCloseSegs">
    <view class="sheet" catchtap="noop">
      <view class="h">过往记录</view>
      <view class="seg-list">
        <view class="seg-item" wx:for="{{segList}}" wx:key="range">
          <view class="seg-name">{{item.name}}</view>
          <view class="seg-range">{{item.range}} · 共 {{item.days}} 天</view>
          <view class="seg-note">{{item.note}}</view>
        </view>
      </view>
      <view class="seg-foot">这些是走过的路，不是要抹掉的东西。</view>
      <button class="btn btn-ghost" bindtap="onCloseSegs">关闭</button>
    </view>
  </view>

  <!-- v0.9.13 提醒未配置时的说明（不假装功能可用） -->
  <view class="mask" wx:if="{{showReminder}}" bindtap="onCloseReminder">
    <view class="sheet" catchtap="noop">
      <view class="h">提醒还开不了</view>
      <view class="sheet-p">
        微信不允许小程序自己弹通知，唯一的办法是「订阅消息」——
        需要先在微信后台申请一个提醒模板，把模板 ID 填进小程序配置。这个还没做。
      </view>
      <view class="sheet-p">
        在那之前，有个土办法很管用：把这个小程序「添加到我的小程序」，
        每天顺手往下拉一下就看到了。
      </view>
      <button class="btn btn-ghost" bindtap="onCloseReminder">知道了</button>
    </view>
  </view>

  <!-- 意见反馈：主入口是微信客服会话（open-type="contact"）。
       需要先在 mp 后台「功能 → 客服」添加客服人员，否则点击会提示未开启客服功能，
       所以下面同时给了「复制反馈模板」这条不依赖后台的备用路径。 -->
  <view class="mask" wx:if="{{showFeedback}}" bindtap="onCloseFeedback">
    <view class="sheet" catchtap="noop">
      <view class="h">意见反馈</view>
      <view class="sheet-p">
        遇到问题、想加功能，或者只是想骂两句，都可以。我们会看。
      </view>

      <button class="btn btn-primary" open-type="contact" hover-class="none">在线留言</button>

      <button class="btn btn-ghost" style="margin-top:16rpx;" bindtap="onCopyFeedback">复制反馈模板</button>

      <view class="fb-note">
        「在线留言」会打开微信客服会话，我们能在这里回复你。
        如果点了没反应，说明客服还没在微信后台配好——那就先「复制反馈模板」，
        粘贴到会话里再发，信息更全。
      </view>

      <button class="btn btn-ghost" style="margin-top:8rpx;" bindtap="onCloseFeedback">关闭</button>
    </view>
  </view>

  <!-- v0.9.14 运行记录 -->
  <view class="mask" wx:if="{{showErrs}}" bindtap="onCloseErrs">
    <view class="sheet" catchtap="noop">
      <view class="h">运行记录</view>
      <view class="sheet-p">
        这些都是小程序自己出的小毛病，已经记在你手机里了，没有上传到任何地方。
        复制一份发给我，我就能知道是怎么坏的。
      </view>

      <view class="err-box">
        <text user-select="true" class="err-text">{{errText}}</text>
      </view>

      <button class="btn btn-primary" style="margin-top:28rpx;" bindtap="onCopyErrs">复制全部</button>
      <button class="btn btn-ghost" style="margin-top:16rpx;" bindtap="onClearErrs">清掉这些记录</button>
      <button class="btn btn-ghost" style="margin-top:8rpx;" bindtap="onCloseErrs">关闭</button>
    </view>
  </view>

</view>
