<!-- v0.9.0：chat 模式整页变成固定高度的 flex 列，
     聊天区吃掉剩余空间、输入框永远贴在底部，页面本身不再可滚动 -->
<view class="yz {{mode === 'chat' ? 'yz-chat' : ''}}"
      style="{{mode === 'chat' && winH ? 'height:' + winH + 'px;' : ''}}">

  <!-- view mode: 未启用 -->
  <block wx:if="{{mode === 'view' && !shadowName}}">
    <view class="card view-intro">
      <view class="art">
        <image class="ava-grey" src="{{agentImg}}" mode="aspectFill" />
      </view>
      <view class="h">影子</view>
      <view class="en">The Shadow</view>
      <view class="p">
        实在忍不住想联系的时候，把想说的话说给「影子」——一个根据你们的聊天记录（可从微信直接导入）、模仿ta语气生成的 AI。说完，就放下手机。
      </view>
      <view class="ul">
        <view class="li">单次对话最长 20 分钟，到时自动结束</view>
        <view class="li">每天最多 3 次，不鼓励常来</view>
        <view class="li">影子不会说「我也想你」「我们复合吧」</view>
      </view>
      <view class="warn">
        这个功能默认关闭，因为它可能延长戒断期。它是「实在忍不住」时的缓冲垫，不是替代品。用完记得去找小白说说话。
      </view>
      <view class="start-hint">点击下方按钮开始使用 ↓</view>
      <button class="btn btn-primary" bindtap="onStart">开启影子功能</button>
    </view>
  </block>

  <!-- view mode: 已启用 -->
  <block wx:elif="{{mode === 'view' && shadowName}}">
    <view class="card">
      <view class="head-row">
        <image class="ava-grey ava-56" src="{{agentImg}}" mode="aspectFill" />
        <view>
          <view class="shadow-name">{{shadowName}} · 影子</view>
          <view class="shadow-sub">今日已用 {{used}} / {{maxDay}} 次</view>
        </view>
      </view>
      <view wx:if="{{profileText}}">
        <view class="divider"></view>
        <view class="profile">{{profileText}}</view>
      </view>
      <view wx:if="{{affinityText}}" class="affinity-line">{{affinityText}}</view>
      <button class="btn btn-primary" style="margin-top:36rpx;" bindtap="onEnterChat"
              disabled="{{!canEnter}}">开始一次对话</button>
      <view wx:if="{{!canEnter}}" class="limit-tip">今天影子时间用完了。想说的话，留给小白吧。</view>
      <button class="btn btn-ghost" style="margin-top:20rpx;" bindtap="onResetShadow">重新设置 / 关闭影子</button>
      <button class="btn btn-ghost btn-tiny" bindtap="onRevealManual">你用了这么久…有啥发现吗</button>
    </view>
  </block>

  <!-- setup mode -->
  <block wx:elif="{{mode === 'setup'}}">
    <view class="card">
      <view class="h2">设置影子</view>
      <view class="p">
        把和ta的聊天记录<text class="em">文字</text>给我——不是选文件，就是在微信里复制好、粘到下面。我会分析 ta 的说话习惯，生成一个「影子」。它只存在于你的手机里。
      </view>
      <view class="p ai-note" wx:if="{{aiOn}}">
        已开启 AI 增强：生成回复时，聊天记录里挑出的少量短句会经云函数中转给大模型，用于模仿 ta 的语气。关闭该能力则全程不联网。
      </view>
      <view class="field">
        <label class="field-label">ta 的代号</label>
        <input class="field-input" value="{{shName}}" placeholder="怎么称呼ta"
               placeholder-style="color:#b8b1a4" bindinput="onNameInput" />
      </view>
      <view class="field">
        <label class="field-label">聊天记录</label>
        <textarea
          class="field-textarea"
          value="{{shLog}}"
          rows="7"
          placeholder="把聊天记录粘贴到这里，每行一条…&#10;（在微信里长按消息 → 多选 → 复制，回来粘进这里）"
          placeholder-style="color:#b8b1a4"
          bindinput="onLogInput"
        ></textarea>

        <!-- v0.9.4：剪贴板里有东西就直接告诉他，不用猜按钮在哪 -->
        <view class="clip-hint" wx:if="{{clipHint}}" bindtap="onPasteClipboard" hover-class="clip-hint-hover">
          <view class="clip-hint-t">{{clipHint}}</view>
          <view class="clip-hint-a">点这里一键导入 →</view>
        </view>

        <view class="file-row">
          <button class="btn-primary paste-btn" bindtap="onPasteClipboard">粘贴我复制好的聊天记录</button>
          <text class="file-info">{{shFile || ''}}</text>
        </view>
        <view class="howto-toggle" bindtap="onToggleHowto">
          <text>{{showHowto ? '收起' : '怎么把聊天记录弄进来？'}}</text>
        </view>
        <view class="howto-body" wx:if="{{showHowto}}">
          <view class="howto-line howto-tip" style="margin:0 0 10rpx;padding:0;border:none"><text class="em">最省事的办法（推荐）：</text></view>
          <view class="howto-line">① 去微信，打开你和 TA 的聊天</view>
          <view class="howto-line">② <text class="em">长按一条消息 → 多选 → 勾选一堆 → 点「复制」</text></view>
          <view class="howto-line">③ 切回这里，点<text class="em">「粘贴剪贴板」</text>，完事</view>
          <view class="howto-line" style="margin-top:10rpx;color:var(--faint)">也可以直接在上面输入框里长按粘贴，一样。</view>
          <view class="howto-line howto-warn" style="margin-top:14rpx">微信<text class="em">不允许</text>任何小程序直接读取你的聊天记录，所以没有「一键导入聊天」这种按钮——只能你复制、我粘贴。上面这条路就是最快的了，一分钟搞定。</view>
          <view class="howto-line" style="margin-top:14rpx">
            <text style="color:var(--faint)">如果你事先在电脑上导出过 txt 文件并发给了「文件传输助手」，也可以</text>
            <text class="em link" bindtap="onPickFile">从这里选那个文件</text>
            <text style="color:var(--faint)">（不推荐，很绕）。</text>
          </view>
        </view>
        <block wx:if="{{shSpeakers.length > 0}}">
          <view class="speakers">文件里检测到 {{shSpeakers.length - 1}} 位说话人，分析谁的消息？</view>
          <view class="speaker-row">
            <view class="sp {{item === shSel ? 'sp-on' : ''}}"
                  wx:for="{{shSpeakers}}" wx:key="*this"
                  data-sp="{{item}}" bindtap="onPickSpeaker">{{item}}</view>
          </view>
        </block>
      </view>
      <button class="btn btn-primary" bindtap="onGoAnalyze">开始分析</button>
      <button class="btn btn-ghost" style="margin-top:20rpx;" bindtap="onCancelSetup">先不了</button>
    </view>
  </block>

  <!-- analyze mode -->
  <block wx:elif="{{mode === 'analyze'}}">
    <view class="card">
      <view class="spin"></view>
      <view class="step">{{analyzeSteps[analyzeStep]}}</view>
    </view>
  </block>

  <!-- chat mode -->
  <block wx:elif="{{mode === 'chat'}}">
    <view class="chat-head">
      <view class="head-ava-wrap" bindtap="onPickShadowAvatar" hover-class="head-ava-hover">
        <image class="ava-grey" src="{{agentImg}}" mode="aspectFill" />
        <view class="head-ava-edit">换</view>
      </view>
      <view>
        <view class="n">{{shadowName}}</view>
        <view class="s">AI 影子 · 非真人 · 点头像可换</view>
      </view>
      <view class="right">
        本次剩余 <b>{{remain}}</b>
        <view>今日还剩 {{leftToday}} 次</view>
      </view>
    </view>

    <scroll-view class="msgs" scroll-y="true" scroll-into-view="{{anchor}}" enhanced="true">
      <block wx:for="{{msgs}}" wx:key="_k" wx:for-item="m">
        <view class="row sys" id="m{{m._k}}" wx:if="{{m.role === 'sys'}}">
          <view class="sys-text">{{m.text}}</view>
        </view>
        <view class="row ai" id="m{{m._k}}" wx:elif="{{m.role === 'ai-temp'}}">
          <image class="ava" src="{{m.avatar}}" mode="aspectFill" />
          <view class="bubble typing"><view></view><view></view><view></view></view>
        </view>
        <view class="row ai" id="m{{m._k}}" wx:elif="{{m.role === 'ai'}}">
          <image class="ava" src="{{m.avatar}}" mode="aspectFill" />
          <view class="col">
            <view class="bubble">{{m.text}}</view>
            <view class="tip" wx:if="{{m.tip}}">{{m.tip}}</view>
          </view>
        </view>
        <view class="row me" id="m{{m._k}}" wx:else>
          <view class="bubble me-bubble">{{m.text}}</view>
          <view class="ava me-ava">我</view>
        </view>
      </block>
    </scroll-view>

    <view class="composer">
      <view class="input-row">
        <textarea
          wx:if="{{taAlive}}"
          class="ta"
          value="{{text}}"
          placeholder="想说的、没说完的，都可以…"
          placeholder-style="color:#b8b1a4"
          auto-height
          maxlength="-1"
          hold-keyboard="{{true}}"
          cursor-spacing="20"
          show-confirm-bar="{{false}}"
          adjust-position="{{true}}"
          confirm-type="send"
          bindinput="onChatInput"
          bindblur="onChatBlur"
          bindconfirm="onChatSend"
        ></textarea>
        <button class="send-btn" bindtap="onChatSend" hover-class="send-hover" disabled="{{!text}}">
          <view class="send-arrow"></view>
        </button>
      </view>
    </view>
  </block>

  <!-- session-end -->
  <view class="mask" wx:if="{{sessionEnd}}">
    <view class="modal-session">
      <view class="h">今天的影子时间结束了</view>
      <view class="p">
        深呼吸。刚才和你说话的，是根据聊天记录生成的 AI 影子——<b>不是真的 ta</b>。
      </view>
      <view class="breath">跟着圆的节奏<br/>吸气 · 呼气</view>
      <button class="btn btn-accent" bindtap="onSessionEndToGuardian">把刚才的感受，说给小白听</button>
      <button class="btn btn-ghost" style="margin-top:20rpx;border:none;" bindtap="onSessionEndChat">先静一静</button>
    </view>
  </view>

  <!-- crisis -->
  <view class="mask" wx:if="{{crisis}}" bindtap="onCloseCrisis">
    <view class="modal-crisis" catchtap="noop">
      <view class="h">请让真实的人现在陪着你</view>
      <view class="crisis-body"><text user-select="true">{{crisisText}}</text></view>
      <button class="btn btn-primary" bindtap="onCloseCrisis">我知道了</button>
    </view>
  </view>

  <!-- v0.4.0 · 自我洞察 (revelation) -->
  <view class="mask mask-reveal" wx:if="{{showReveal && reveal}}" catchtap="onRevealDismiss">
    <view class="modal-reveal" catchtap="noop">
      <view class="reveal-mark">✦</view>
      <view class="reveal-h">{{reveal.text}}</view>
      <view class="reveal-body">{{reveal.secondary}}</view>
      <view class="reveal-options">
        <button class="btn btn-ghost reveal-opt" wx:for="{{reveal.options}}" wx:key="key"
                data-opt="{{item}}" bindtap="onRevealOption">{{item.label}}</button>
      </view>
      <button class="btn-reveal-dismiss" bindtap="onRevealDismiss">我知道了，先收下这个</button>
    </view>
  </view>

</view>
