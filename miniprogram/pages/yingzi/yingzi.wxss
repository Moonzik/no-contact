/* pages/yingzi/yingzi.wxss */

.yz {
  padding: 32rpx 44rpx 200rpx;
  box-sizing: border-box;
  min-height: 100vh;
  padding-top: calc(32rpx + env(safe-area-inset-top));
}

/* === view === */
.view-intro {
  margin-top: 16rpx;
}
.art {
  display: flex;
  justify-content: center;
  margin-bottom: 36rpx;
}
.ava-grey {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  filter: grayscale(1) opacity(0.85);
  border: 1rpx solid var(--line);
  background: #fff;
}
.ava-56 {
  width: 112rpx;
  height: 112rpx;
}
.view-intro .h {
  font-family: var(--serif);
  font-size: 44rpx;
  letter-spacing: 8rpx;
  text-align: center;
}
.view-intro .en {
  text-align: center;
  font-size: 22rpx;
  color: var(--faint);
  letter-spacing: 8rpx;
  margin: 8rpx 0 32rpx;
  text-transform: uppercase;
}
.view-intro .p {
  color: var(--sub);
  font-size: 27rpx;
  line-height: 1.9;
  margin: 24rpx 0 8rpx;
}
.ul { margin: 16rpx 0 8rpx; padding: 0; }
.li {
  font-size: 26rpx;
  color: var(--sub);
  padding-left: 32rpx;
  position: relative;
  margin-bottom: 12rpx;
}
.li::before {
  content: '·';
  position: absolute;
  left: 4rpx;
  color: var(--accent);
}
.warn {
  background: #fdf3f0;
  border: 1rpx solid #e8cfc5;
  border-radius: 28rpx;
  padding: 26rpx 32rpx;
  font-size: 25rpx;
  color: var(--danger);
  line-height: 1.8;
  margin: 32rpx 0;
}

/* === view (enabled) === */
.head-row {
  display: flex;
  gap: 28rpx;
  align-items: center;
}
.shadow-name {
  font-family: var(--serif);
  letter-spacing: 4rpx;
  font-size: 34rpx;
}
.shadow-sub {
  font-size: 24rpx;
  color: var(--faint);
  margin-top: 6rpx;
}
.profile {
  font-size: 25rpx;
  color: var(--sub);
  line-height: 1.9;
  white-space: pre-wrap;
}
.limit-tip {
  text-align: center;
  font-size: 25rpx;
  color: var(--sub);
  margin-top: 20rpx;
}

/* === setup === */
.h2 {
  font-family: var(--serif);
  letter-spacing: 6rpx;
  font-size: 38rpx;
  margin-bottom: 16rpx;
}
.p {
  color: var(--sub);
  font-size: 27rpx;
  line-height: 1.9;
}
.file-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
  margin-bottom: 16rpx;
}
.file-btn {
  margin: 0;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
}
.file-info {
  font-size: 24rpx;
  color: var(--faint);
  flex: 1;
}
.speakers {
  font-size: 25rpx;
  margin-top: 20rpx;
  line-height: 2;
  color: var(--sub);
}
.speaker-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}
.sp {
  font-size: 25rpx;
  color: var(--sub);
  padding: 4rpx 0;
  margin-right: 20rpx;
  border-bottom: 4rpx solid transparent;
}
.sp-on {
  color: var(--ink);
  font-weight: 600;
  border-bottom-color: var(--ink);
}

/* === analyze === */
.spin {
  width: 88rpx;
  height: 88rpx;
  border: 4rpx solid var(--line);
  border-top-color: var(--ink);
  border-radius: 50%;
  margin: 0 auto 40rpx;
  animation: spin 1s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.step {
  text-align: center;
  color: var(--sub);
  font-size: 27rpx;
  letter-spacing: 4rpx;
  min-height: 48rpx;
}

/* === chat === */
.chat-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 12rpx 0 28rpx;
  border-bottom: 1rpx solid var(--line);
  margin-bottom: 28rpx;
}
.chat-head .n {
  font-family: var(--serif);
  font-size: 34rpx;
  letter-spacing: 4rpx;
}
.chat-head .s {
  font-size: 23rpx;
  color: var(--faint);
  letter-spacing: 2rpx;
  margin-top: 4rpx;
}
.chat-head .ava-grey {
  width: 88rpx;
  height: 88rpx;
}
.chat-head .right {
  margin-left: auto;
  font-size: 23rpx;
  color: var(--accent);
  text-align: right;
  line-height: 1.5;
}
.chat-head .right b {
  font-weight: 600;
}

.msgs {
  /* 占据剩余空间 */
  flex: 1;
  padding: 8rpx 4rpx 24rpx;
  box-sizing: border-box;
}
.row { display: flex; gap: 20rpx; margin: 0 0 28rpx; max-width: 88%; }
.row.sys { align-self: center; margin: 0 auto 14rpx; max-width: 100%; }
.row.ai { align-self: flex-start; }
.row.me { align-self: flex-end; flex-direction: row-reverse; margin-left: auto; }
.row .ava {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  border: 1rpx solid var(--line);
  background: #fff;
  flex-shrink: 0;
  margin-top: 4rpx;
}
.row .me-ava {
  background: var(--ink);
  color: #faf9f4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  border-color: var(--ink);
}
.bubble {
  padding: 20rpx 28rpx;
  border-radius: 8rpx 28rpx 28rpx 28rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  font-size: 29rpx;
  line-height: 1.7;
  max-width: 100%;
  word-break: break-word;
  white-space: pre-wrap;
  display: inline-block;
}
.col { display: flex; flex-direction: column; gap: 8rpx; max-width: 100%; }
.row.me .bubble,
.me-bubble {
  background: var(--ink);
  color: #faf9f4;
  border-color: var(--ink);
  border-radius: 28rpx 8rpx 28rpx 28rpx;
}
.tip {
  font-size: 22rpx;
  color: var(--faint);
  margin-top: 16rpx;
  border-top: 1rpx dashed var(--line);
  padding-top: 12rpx;
}
.sys-text {
  background: transparent;
  border: none;
  color: var(--faint);
  font-size: 24rpx;
  text-align: center;
  padding: 0;
  white-space: pre-wrap;
}
.typing {
  display: flex;
  gap: 8rpx;
  padding: 24rpx 32rpx;
}
.typing view {
  width: 10rpx; height: 10rpx; border-radius: 50%;
  background: var(--faint);
  opacity: 0.25;
  animation: blink 1.2s infinite;
}
.typing view:nth-child(2) { animation-delay: 0.2s; }
.typing view:nth-child(3) { animation-delay: 0.4s; }
@keyframes blink { 0%,60%,100% { opacity:.25; } 30% { opacity:1; } }

.composer {
  border-top: 1rpx solid var(--line);
  padding: 24rpx 0 calc(28rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}
.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  position: relative;
}
.ta {
  flex: 1;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  padding: 22rpx 100rpx 22rpx 28rpx;
  min-height: 92rpx;
  max-height: 220rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  line-height: 1.5;
}
.send {
  position: absolute;
  right: 14rpx;
  bottom: 14rpx;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: var(--ink);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.send[disabled] { opacity: 0.35; }
.send-arrow {
  width: 0; height: 0;
  border-style: solid;
  border-width: 16rpx 0 16rpx 24rpx;
  border-color: transparent transparent transparent #faf9f4;
  margin-left: 6rpx;
}

/* === 弹层 === */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(38, 35, 30, 0.45);
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  box-sizing: border-box;
}
.modal-session {
  background: var(--bg);
  border-radius: 28rpx;
  padding: 60rpx 44rpx;
  width: 100%;
  max-width: 560rpx;
  text-align: center;
}
.modal-session .h {
  font-family: var(--serif);
  font-size: 48rpx;
  letter-spacing: 8rpx;
  margin-bottom: 28rpx;
}
.modal-session .p {
  color: var(--sub);
  font-size: 28rpx;
  max-width: 600rpx;
  margin: 0 auto;
  line-height: 1.8;
}
.modal-session .breath {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  border: 1rpx solid var(--line);
  margin: 52rpx auto;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--faint);
  font-size: 24rpx;
  letter-spacing: 4rpx;
  animation: breath 8s ease-in-out infinite;
}
@keyframes breath { 0%,100%{transform:scale(.88);opacity:.6;} 40%{transform:scale(1.08);opacity:1;} }

.modal-crisis {
  background: var(--bg);
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  width: 100%;
  max-width: 560rpx;
}
.modal-crisis .h {
  font-family: var(--serif);
  font-size: 36rpx;
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
}
.crisis-body {
  font-size: 28rpx;
  color: var(--danger);
  background: #fdf3f0;
  border: 1rpx solid #e8cfc5;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  line-height: 1.9;
  margin-bottom: 36rpx;
  white-space: pre-wrap;
}
