/* pages/yingzi/yingzi.wxss */

.yz {
  padding: 32rpx 44rpx 200rpx;
  box-sizing: border-box;
  min-height: 100vh;
  padding-top: calc(32rpx + env(safe-area-inset-top));
}

/* v0.9.0 · chat 模式：整页锁高为 flex 列。
   以前 .yz 是普通块级 + min-height:100vh + padding-bottom:200rpx，
   .msgs 的 flex:1 完全无效（父级不是 flex），聊天一多就把输入框顶下去，
   页面整体还能往下拖 —— 现在彻底锁死。 */
.yz-chat {
  display: flex;
  flex-direction: column;
  padding: 0;
  padding-top: env(safe-area-inset-top);
  min-height: 0;
  height: calc(100vh - 100rpx - env(safe-area-inset-bottom));
  overflow: hidden;
  box-sizing: border-box;
}

/* === view === */
.view-intro {
  margin-top: 16rpx;
}
.art {
  display: flex;
  justify-content: center;
  margin-bottom: 36rpx;
}
.ava-grey {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  filter: grayscale(1) opacity(0.85);
  border: 1rpx solid var(--line);
  background: #fff;
}
.ava-56 {
  width: 112rpx;
  height: 112rpx;
}
.view-intro .h {
  font-family: var(--serif);
  font-size: 44rpx;
  letter-spacing: 8rpx;
  text-indent: 8rpx; /* 抵消 letter-spacing 造成的居中偏移 */
  text-align: center;
}
.view-intro .en {
  text-align: center;
  font-size: 22rpx;
  color: var(--faint);
  letter-spacing: 8rpx;
  text-indent: 8rpx; /* 大写英文 + 宽字距，偏移最明显 */
  margin: 8rpx 0 32rpx;
  text-transform: uppercase;
}
.view-intro .p {
  color: var(--sub);
  font-size: 27rpx;
  line-height: 1.9;
  margin: 24rpx 0 8rpx;
}
.ul { margin: 16rpx 0 8rpx; padding: 0; }
.li {
  font-size: 26rpx;
  color: var(--sub);
  padding-left: 32rpx;
  position: relative;
  margin-bottom: 12rpx;
}
.li::before {
  content: '·';
  position: absolute;
  left: 4rpx;
  color: var(--accent);
}
.warn {
  background: #fdf3f0;
  border: 1rpx solid #e8cfc5;
  border-radius: 28rpx;
  padding: 26rpx 32rpx;
  font-size: 25rpx;
  color: var(--danger);
  line-height: 1.8;
  margin: 32rpx 0;
}

/* === view (enabled) === */
.head-row {
  display: flex;
  gap: 28rpx;
  align-items: center;
}
.shadow-name {
  font-family: var(--serif);
  letter-spacing: 4rpx;
  font-size: 34rpx;
}
.shadow-sub {
  font-size: 24rpx;
  color: var(--faint);
  margin-top: 6rpx;
}
.profile {
  font-size: 25rpx;
  color: var(--sub);
  line-height: 1.9;
  white-space: pre-wrap;
}
.limit-tip {
  text-align: center;
  font-size: 25rpx;
  color: var(--sub);
  margin-top: 20rpx;
}

.start-hint {
  text-align: center;
  font-size: 24rpx;
  color: var(--faint);
  margin: 28rpx 0 16rpx;
  letter-spacing: 2rpx;
}
.h2 {
  font-family: var(--serif);
  letter-spacing: 6rpx;
  font-size: 38rpx;
  margin-bottom: 16rpx;
}
.p {
  color: var(--sub);
  font-size: 27rpx;
  line-height: 1.9;
}
.file-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
  margin-bottom: 16rpx;
}
.file-btn {
  margin: 0;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
}
.file-info {
  font-size: 24rpx;
  color: var(--faint);
  flex: 1;
}

/* 「怎么导出聊天记录」折叠说明 */
.howto-toggle {
  font-size: 24rpx;
  color: var(--accent);
  margin-top: 18rpx;
  padding: 6rpx 0;
}
.howto-body {
  background: #faf7f1;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  margin-top: 14rpx;
}
.howto-line {
  font-size: 24rpx;
  color: var(--sub);
  line-height: 1.85;
  margin-bottom: 4rpx;
}
.howto-line .em {
  color: var(--ink);
  font-weight: 600;
}
.howto-warn {
  margin-top: 10rpx;
  color: var(--danger);
}
.howto-tip {
  margin-top: 10rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed var(--line);
  color: var(--accent);
}
.speakers {
  font-size: 25rpx;
  margin-top: 20rpx;
  line-height: 2;
  color: var(--sub);
}
.speaker-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}
.sp {
  font-size: 25rpx;
  color: var(--sub);
  padding: 4rpx 0;
  margin-right: 20rpx;
  border-bottom: 4rpx solid transparent;
}
.sp-on {
  color: var(--ink);
  font-weight: 600;
  border-bottom-color: var(--ink);
}

/* === analyze === */
.spin {
  width: 88rpx;
  height: 88rpx;
  border: 4rpx solid var(--line);
  border-top-color: var(--ink);
  border-radius: 50%;
  margin: 0 auto 40rpx;
  animation: spin 1s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.step {
  text-align: center;
  color: var(--sub);
  font-size: 27rpx;
  letter-spacing: 4rpx;
  text-indent: 4rpx; /* 抵消 letter-spacing 造成的居中偏移 */
  min-height: 48rpx;
}

/* === chat === */
.chat-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 12rpx 0 28rpx;
  border-bottom: 1rpx solid var(--line);
  margin-bottom: 28rpx;
}
.chat-head .n {
  font-family: var(--serif);
  font-size: 34rpx;
  letter-spacing: 4rpx;
}
.chat-head .s {
  font-size: 23rpx;
  color: var(--faint);
  letter-spacing: 2rpx;
  margin-top: 4rpx;
}
.chat-head .ava-grey {
  width: 88rpx;
  height: 88rpx;
}
.chat-head .right {
  margin-left: auto;
  font-size: 23rpx;
  color: var(--accent);
  text-align: right;
  line-height: 1.5;
}
.chat-head .right b {
  font-weight: 600;
}

.msgs {
  /* v0.9.0：吃掉剩余高度且不撑开父级。
     没有 min-height:0 时 flex 子项会被内容顶开，输入框就被挤出屏幕了 */
  flex: 1 1 0;
  min-height: 0;
  overflow: hidden;
  padding: 24rpx 44rpx;
  box-sizing: border-box;
}
.row { display: flex; gap: 20rpx; margin: 0 0 28rpx; max-width: 88%; }
.row.sys { align-self: center; margin: 0 auto 14rpx; max-width: 100%; }
.row.ai { align-self: flex-start; }
.row.me { align-self: flex-end; flex-direction: row-reverse; margin-left: auto; }
.row .ava {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  border: 1rpx solid var(--line);
  background: #fff;
  flex-shrink: 0;
  margin-top: 4rpx;
}
.row .me-ava {
  background: var(--ink);
  color: #faf9f4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  border-color: var(--ink);
}
.bubble {
  padding: 20rpx 28rpx;
  border-radius: 8rpx 28rpx 28rpx 28rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  font-size: 29rpx;
  line-height: 1.7;
  max-width: 100%;
  word-break: break-word;
  white-space: pre-wrap;
  display: inline-block;
}
.col { display: flex; flex-direction: column; gap: 8rpx; max-width: 100%; }
.row.me .bubble,
.me-bubble {
  background: var(--ink);
  color: #faf9f4;
  border-color: var(--ink);
  border-radius: 28rpx 8rpx 28rpx 28rpx;
}
.tip {
  font-size: 22rpx;
  color: var(--faint);
  margin-top: 16rpx;
  border-top: 1rpx dashed var(--line);
  padding-top: 12rpx;
}
.sys-text {
  background: transparent;
  border: none;
  color: var(--faint);
  font-size: 24rpx;
  text-align: center;
  padding: 0;
  white-space: pre-wrap;
}
.typing {
  display: flex;
  gap: 8rpx;
  padding: 24rpx 32rpx;
}
.typing view {
  width: 10rpx; height: 10rpx; border-radius: 50%;
  background: var(--faint);
  opacity: 0.25;
  animation: blink 1.2s infinite;
}
.typing view:nth-child(2) { animation-delay: 0.2s; }
.typing view:nth-child(3) { animation-delay: 0.4s; }
@keyframes blink { 0%,60%,100% { opacity:.25; } 30% { opacity:1; } }

/* v0.9.0：chat 模式下头部固定，不再吃掉 flex 空间 */
.yz-chat .chat-head {
  flex: none;
  padding: 20rpx 44rpx 24rpx;
  margin-bottom: 0;
}

.composer {
  flex: none;
  flex-shrink: 0;
  border-top: 1rpx solid var(--line);
  padding: 18rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}
.input-row {
  display: flex;
  align-items: center;     /* 单行时不随内容上下抖动 */
  gap: 12rpx;
}
.ta {
  flex: 1;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  padding: 14rpx 20rpx;
  min-height: 40rpx;
  max-height: 200rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.4;
}

/* v0.9.0 · 发送按钮：与小白完全一致的 64rpx 严格圆形。
   旧版 .send 用绝对定位且没重置 button 默认样式 —— ::after 边框、
   自带 padding 和 line-height 会把 68rpx 的圆撑成椭圆/方块。 */
.send-btn {
  flex-shrink: 0;
  box-sizing: border-box;
  width: 64rpx !important;
  height: 64rpx !important;
  min-height: 64rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  line-height: 1 !important;
  font-size: 0 !important;      /* button 自带字体会撑大容器 */
  text-align: center;
  border-radius: 50% !important;
  background: var(--ink);
  border: none !important;
  display: flex;
  align-items: center;
  justify-content: center;
}
.send-btn::after {
  content: none;                 /* 彻底去掉 button 默认的 ::after 伪元素 */
  display: none;
  border: none !important;
  width: 0; height: 0;
}
.send-btn[disabled] { opacity: 0.35; }
.send-hover { opacity: 0.65; }
.send-arrow {
  width: 0; height: 0;
  border-style: solid;
  border-width: 12rpx 0 12rpx 18rpx;
  border-color: transparent transparent transparent #faf9f4;
  margin-left: 4rpx;
}

/* === 弹层 === */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(38, 35, 30, 0.45);
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  box-sizing: border-box;
}
.modal-session {
  background: var(--bg);
  border-radius: 28rpx;
  padding: 60rpx 44rpx;
  width: 100%;
  max-width: 560rpx;
  text-align: center;
}
.modal-session .h {
  font-family: var(--serif);
  font-size: 48rpx;
  letter-spacing: 8rpx;
  margin-bottom: 28rpx;
}
.modal-session .p {
  color: var(--sub);
  font-size: 28rpx;
  max-width: 600rpx;
  margin: 0 auto;
  line-height: 1.8;
}
.modal-session .breath {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  border: 1rpx solid var(--line);
  margin: 52rpx auto;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--faint);
  font-size: 24rpx;
  letter-spacing: 4rpx;
  animation: breath 8s ease-in-out infinite;
}
@keyframes breath { 0%,100%{transform:scale(.88);opacity:.6;} 40%{transform:scale(1.08);opacity:1;} }

.modal-crisis {
  background: var(--bg);
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  width: 100%;
  max-width: 560rpx;
}
.modal-crisis .h {
  font-family: var(--serif);
  font-size: 36rpx;
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
}
.crisis-body {
  font-size: 28rpx;
  color: var(--danger);
  background: #fdf3f0;
  border: 1rpx solid #e8cfc5;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  line-height: 1.9;
  margin-bottom: 36rpx;
  white-space: pre-wrap;
}

/* === v0.4.0 · 相似度阶段文案 + 自我洞察面板 === */
.affinity-line {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--faint);
  text-align: center;
  letter-spacing: 2rpx;
}
.btn-tiny {
  margin-top: 12rpx !important;
  font-size: 24rpx !important;
  padding: 12rpx 24rpx !important;
  background: transparent !important;
  color: var(--faint) !important;
}

.mask-reveal {
  /* rgba 背景是兜底：安卓旧 WebView 不支持 backdrop-filter，靠它保证文字可读 */
  background: rgba(40, 32, 22, 0.78);
  -webkit-backdrop-filter: blur(8rpx);
  backdrop-filter: blur(8rpx);
  align-items: center;
  justify-content: center;
}
.modal-reveal {
  width: 86%;
  max-width: 640rpx;
  background: var(--paper, #f7f3ea);
  border-radius: 28rpx;
  padding: 56rpx 48rpx 40rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 60rpx rgba(0,0,0,0.18);
  position: relative;
  animation: revealIn 380ms ease-out;
}
@keyframes revealIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.reveal-mark {
  position: absolute;
  top: -34rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: var(--paper, #f7f3ea);
  border: 1rpx solid var(--line, #d8d2c2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #8a6f3a;
  letter-spacing: 0;
}
.reveal-h {
  font-family: var(--serif);
  font-size: 32rpx;
  line-height: 1.55;
  letter-spacing: 2rpx;
  color: var(--ink, #2a241c);
  text-align: center;
  margin-bottom: 28rpx;
}
.reveal-body {
  font-size: 27rpx;
  line-height: 1.95;
  color: var(--sub, #5a4d3a);
  white-space: pre-wrap;
  margin-bottom: 36rpx;
  text-align: center;
}
.reveal-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.reveal-opt {
  width: 100% !important;
  margin: 0 !important;
  border: 1rpx solid var(--line, #d8d2c2) !important;
  background: transparent !important;
  color: var(--ink, #2a241c) !important;
  font-size: 28rpx !important;
  padding: 22rpx !important;
  border-radius: 999rpx !important;
}
.reveal-opt::after { content: none; }
.btn-reveal-dismiss {
  margin-top: 16rpx;
  background: transparent !important;
  border: none !important;
  color: var(--faint, #9b8c70) !important;
  font-size: 24rpx !important;
  padding: 16rpx !important;
  letter-spacing: 2rpx;
}
.btn-reveal-dismiss::after { content: none; }

/* v0.9.4 · 导入区：主推「从微信复制文字」，把选文件降级到折叠说明里 */
.clip-hint {
  background: #f6f1e6;
  border: 1rpx solid #e6dbc6;
  border-radius: 20rpx;
  padding: 20rpx 26rpx;
  margin: 8rpx 0 20rpx;
}
.clip-hint-hover { background: #efe7d6; }
.clip-hint-t {
  font-size: 25rpx;
  color: var(--ink);
  line-height: 1.6;
}
.clip-hint-a {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: var(--accent, #9a5d3a);
  font-weight: 600;
}
.paste-btn {
  margin: 0;
  flex: 1;
  font-size: 28rpx;
  padding: 22rpx 0;
  border-radius: 999rpx;
}
.paste-btn::after { display: none; }
.howto-line .link {
  text-decoration: underline;
  padding: 0 2rpx;
}

/* v0.9.0 · AI 开启时的知情提示 */
.ai-note {
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--faint);
  background: var(--card);
  border-left: 4rpx solid var(--line);
  padding: 16rpx 20rpx;
  margin-top: 16rpx;
}
