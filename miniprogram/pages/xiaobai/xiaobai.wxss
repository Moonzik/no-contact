/* pages/xiaobai/xiaobai.wxss */

.xa {
  display: flex;
  flex-direction: column;
  /* 高度由页面用 windowHeight（不含 tabBar）以行内样式写入；
     下面这行是兜底：只在拿不到系统信息时才生效，且扣掉 tabBar 与安全区 */
  height: calc(100vh - 100rpx - env(safe-area-inset-bottom));
  height: calc(100vh - 100rpx - constant(safe-area-inset-bottom));
  background: var(--bg);
  overflow: hidden;
}

/* 人格 */
.persona {
  white-space: nowrap;
  padding: 24rpx 44rpx 16rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}
.pchip {
  display: inline-block;
  border: 1rpx solid var(--line);
  background: var(--card);
  border-radius: 24rpx;
  padding: 16rpx 28rpx;
  margin-right: 16rpx;
  font-size: 25rpx;
  color: var(--sub);
  line-height: 1.4;
  text-align: left;
}
.pchip.on {
  border-color: var(--ink);
  color: var(--ink);
}
.pchip-b {
  font-size: 26rpx;
  letter-spacing: 2rpx;
  font-weight: 500;
}
.pchip-d {
  font-size: 22rpx;
  color: var(--sub);
  margin-top: 4rpx;
}
.pchip.on .pchip-d {
  color: var(--sub);
}

/* 聊天头 */
.chat-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 12rpx 44rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
  margin: 0 44rpx 28rpx;
  flex-shrink: 0;
}
.chat-head .ava {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 1rpx solid var(--line);
  background: #fff;
}
.chat-head .n {
  font-family: var(--serif);
  font-size: 34rpx;
  letter-spacing: 4rpx;
}
.chat-head .s {
  font-size: 23rpx;
  color: var(--faint);
  letter-spacing: 2rpx;
}

/* 消息流：flex:1 + min-height:0 是关键
   —— 少了 min-height:0，scroll-view 会被内容撑开，把底部输入框顶出屏幕 */
.msgs {
  flex: 1 1 0;
  min-height: 0;
  overflow: hidden;
  padding: 8rpx 4rpx 24rpx;
  box-sizing: border-box;
  /* v0.9.7：同影子页——scroll-view 必须显式 flex column，align-self 才生效 */
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.row {
  display: flex;
  gap: 20rpx;
  margin: 0 44rpx 28rpx;
  max-width: 88%;
}
.row.sys {
  align-self: center;
  margin: 0 auto 14rpx;
  max-width: 100%;
}
.row.ai {
  align-self: flex-start;
}
/* v0.9.9：同影子页——去掉 row-reverse，头像才会在最右侧 */
.row.me {
  align-self: flex-end;
  margin-left: auto;
  justify-content: flex-end;
}
.row .ava {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 1rpx solid var(--line);
  background: #fff;
  flex-shrink: 0;
  margin-top: 4rpx;
}
.row .me-ava {
  background: var(--ink);
  color: #faf9f4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  border-color: var(--ink);
}
.bubble {
  padding: 20rpx 28rpx;
  border-radius: 8rpx 28rpx 28rpx 28rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  font-size: 29rpx;
  line-height: 1.7;
  max-width: 100%;
  word-break: break-word;
  white-space: pre-wrap;
  display: inline-block;
}
.col { display: flex; flex-direction: column; gap: 8rpx; max-width: 100%; }
.row.me .bubble,
.me-bubble {
  background: var(--ink);
  color: #faf9f4;
  border-color: var(--ink);
  border-radius: 28rpx 8rpx 28rpx 28rpx;
}
.tip {
  font-size: 22rpx;
  color: var(--faint);
  margin-top: 16rpx;
  border-top: 1rpx dashed var(--line);
  padding-top: 12rpx;
}
.sys .sys-text {
  background: transparent;
  border: none;
  color: var(--faint);
  font-size: 24rpx;
  text-align: center;
  padding: 0;
  white-space: pre-wrap;
}
.anchor { height: 4rpx; }

/* 打字动画 */
.typing {
  display: flex;
  gap: 8rpx;
  padding: 24rpx 32rpx;
}
.typing view {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--faint);
  opacity: 0.25;
  animation: blink 1.2s infinite;
}
.typing view:nth-child(2) { animation-delay: 0.2s; }
.typing view:nth-child(3) { animation-delay: 0.4s; }
@keyframes blink {
  0%, 60%, 100% { opacity: 0.25; }
  30% { opacity: 1; }
}

/* 危机弹层 */
.crisis-mask {
  position: fixed;
  inset: 0;
  background: rgba(38, 35, 30, 0.45);
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  box-sizing: border-box;
}
.crisis-modal {
  background: var(--bg);
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  width: 100%;
  max-width: 560rpx;
}
.crisis-title {
  font-family: var(--serif);
  font-size: 36rpx;
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
}
.crisis-body {
  font-size: 28rpx;
  color: var(--danger);
  background: #fdf3f0;
  border: 1rpx solid #e8cfc5;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  line-height: 1.9;
  margin-bottom: 36rpx;
  white-space: pre-wrap;
}

/* 底部 composer —— 仿微信原生聊天手感，紧凑 */
.composer {
  flex: none;                 /* 输入框永远不被挤压 */
  flex-shrink: 0;
  border-top: 1rpx solid var(--line);
  padding: 18rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}
.chips {
  white-space: nowrap;
  padding-bottom: 12rpx;
}
.chip {
  display: inline-block;
  border: 1rpx solid var(--line);
  background: var(--card);
  border-radius: 99rpx;
  padding: 10rpx 22rpx;
  margin-right: 12rpx;
  font-size: 24rpx;
  color: var(--sub);
}
.input-row {
  display: flex;
  align-items: center;     /* 微信是 center 对齐，单行时不随内容上下抖 */
  gap: 12rpx;
}
/* v0.9.10：与影子页同步修复——min-height 对齐单行自然高度，行高显式化，
   避免 auto-height 在两个高度之间跳动导致文字时而被裁 */
.ta {
  flex: 1;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  padding: 14rpx 20rpx;
  min-height: 72rpx;
  max-height: 198rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 42rpx;
}
/* 发送按钮：严格 64rpx 圆形，重置 button 默认 padding/font 撑大变椭圆 */
.send-btn {
  flex-shrink: 0;
  box-sizing: border-box;
  width: 64rpx !important;
  height: 64rpx !important;
  min-height: 64rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  line-height: 1 !important;
  font-size: 0 !important;        /* button 自带字体会撑大容器 */
  text-align: center;
  border-radius: 50% !important;
  background: var(--ink);
  border: none !important;
  display: flex;
  align-items: center;
  justify-content: center;
}
.send-btn::after {
  content: none;                   /* 彻底去掉 button 默认的 ::after 伪元素 */
  display: none;
  border: none !important;
  width: 0; height: 0;
}
.send-hover { opacity: 0.65; }
.send-arrow {
  width: 0; height: 0;
  border-style: solid;
  border-width: 12rpx 0 12rpx 18rpx;
  border-color: transparent transparent transparent #faf9f4;
  margin-left: 4rpx;
}
