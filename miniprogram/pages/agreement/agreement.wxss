/* pages/agreement/agreement.wxss — 服务协议排版：长文，所以行高放大到 1.8 */
page {
  background: #faf9f4;
}

.ag {
  padding: 48rpx 44rpx 80rpx;
}

.ag-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #26231e;
  line-height: 1.4;
}

.ag-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #a49c8d;
}

.ag-lead {
  margin-top: 28rpx;
  padding: 24rpx 26rpx;
  background: #f2efe6;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #5f594e;
}

.sec {
  margin-top: 44rpx;
}

.sec-h {
  font-size: 30rpx;
  font-weight: 600;
  color: #26231e;
  line-height: 1.5;
}

.sec-p {
  margin-top: 16rpx;
  font-size: 27rpx;
  line-height: 1.8;
  color: #3d3931;
}

.sec-li {
  margin-top: 14rpx;
  font-size: 27rpx;
  line-height: 1.8;
  color: #3d3931;
  padding-left: 8rpx;
}

.ag-privacy {
  margin-top: 48rpx;
  padding: 24rpx 26rpx;
  background: #f6f3ea;
  border: 1rpx solid #e3ddd0;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #8a6f4e;
  line-height: 1.6;
}

.ag-privacy-hover {
  background: #efeade;
}

.ag-foot {
  margin-top: 56rpx;
  text-align: center;
  font-size: 25rpx;
  color: #b0a894;
}
