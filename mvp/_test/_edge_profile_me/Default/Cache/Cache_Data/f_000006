function decodeChatFile(buf){
  var u8 = new Uint8Array(buf);
  if(u8.length>=2 && u8[0]===0xFF && u8[1]===0xFE) return new TextDecoder('utf-16le').decode(buf);
  if(u8.length>=2 && u8[0]===0xFE && u8[1]===0xFF) return new TextDecoder('utf-16be').decode(buf);
  if(u8.length>=3 && u8[0]===0xEF && u8[1]===0xBB && u8[2]===0xBF) return new TextDecoder('utf-8').decode(buf);
  /* 无 BOM：隔字节大量为 0 → 疑似 UTF-16 中文文本 */
  var z=0, n=Math.min(u8.length,400);
  for(var i=1;i<n;i+=2){ if(u8[i]===0) z++; }
  if(n>40 && z>n/4) return new TextDecoder('utf-16le').decode(buf);
  return new TextDecoder('utf-8').decode(buf);
}
function wechatHtmlToText(h){
  h = h.replace(/<script[\s\S]*?<\/script>/gi,' ').replace(/<style[\s\S]*?<\/style>/gi,' ');
  h = h.replace(/<br\s*\/?>/gi,'\n').replace(/<\/(td|div|p|li|tr|h\d)>/gi,'\n');
  h = h.replace(/<[^>]+>/g,'\n');
  var d = document.createElement('div');
  d.innerHTML = h;
  return d.textContent || '';
}
function parseWeChatLog(raw){
  if(/<html|<body|<table|<div/i.test(raw.slice(0,2000))) raw = wechatHtmlToText(raw);
  var lines = raw.split(/\r?\n/).map(function(s){ return s.trim(); });
  /* 微信导出常见头：“2023-05-12 21:34:05 张三” 或 “张三 2023/5/12 21:34” 或 “2023年5月12日 下午3:04 张三” */
  var HEAD1 = /^(\d{4}[-\/.年]\d{1,2}[-\/.月]\d{1,2}日?)\s*(上午|下午|晚上|凌晨)?\s*(\d{1,2}:\d{2}(?::\d{2})?)\s*[，,]?\s*(.+)$/;
  var HEAD2 = /^(.+?)\s+(\d{4}[-\/.年]\d{1,2}[-\/.月]\d{1,2}日?)\s*(上午|下午|晚上|凌晨)?\s*(\d{1,2}:\d{2}(?::\d{2})?)$/;
  var DAYSEP = /^[—\-–=﹉~*·]{3,}\s*\d{4}|^[—\-–=﹉~*·]{3,}$/;
  var msgs = [], cur = null, found = false;
  lines.forEach(function(ln){
    if(!ln) return;
    if(DAYSEP.test(ln)) return;
    if(/^(以上是|以下是|系统消息)/.test(ln)) return;
    var m = ln.match(HEAD1), name = null;
    if(m) name = m[4];
    else { m = ln.match(HEAD2); if(m) name = m[1]; }
    if(name){
      found = true;
      cur = { name: name.replace(/[:：]\s*$/,''), text: '' };
      msgs.push(cur);
      return;
    }
    if(/^\[[^\]]{1,10}\]$/.test(ln)) return; /* [图片][语音][动画表情] 等占位 */
    if(cur){ cur.text += (cur.text ? '\n' : '') + ln; }
    else { msgs.push({name:'', text:ln}); }
  });
  if(!found){
    return { speakers:[], byName:{}, cleaned: lines.filter(function(l){ return l && !DAYSEP.test(l); }).join('\n') };
  }
  var byName = {};
  msgs.forEach(function(m){
    if(!m.name || !m.text) return;
    (byName[m.name] = byName[m.name] || []).push(m.text);
  });
  var speakers = Object.keys(byName).sort(function(a,b){ return byName[b].length - byName[a].length; });
  return { speakers: speakers, byName: byName,
    cleaned: msgs.map(function(m){ return m.text; }).filter(Boolean).join('\n') };
}
