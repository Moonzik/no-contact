<title>留白 · 把想念留白，把自己找回</title>
<link rel="icon" href="assets/appicon.png" data-page-node-id="oDLDoCXbUbq0nkWnM00n1s">
<style>
:root{
  --bg:#faf9f4;
  --card:#ffffff;
  --ink:#26231e;
  --sub:#8f887b;
  --faint:#b8b1a4;
  --line:#e9e4d8;
  --accent:#b5623c;
  --accent-soft:#f5ece6;
  --danger:#a5432e;
  --serif:"Noto Serif SC","Source Han Serif SC","Songti SC","STSong","SimSun",serif;
  --sans:-apple-system,"PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{height:100%;}
body{
  background:var(--bg);color:var(--ink);font-family:var(--sans);
  font-size:15px;line-height:1.7;
}
#frame{
  max-width:480px;margin:0 auto;min-height:100dvh;position:relative;
  background:var(--bg);
}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit;}
input,textarea,select{font-family:inherit;font-size:15px;color:var(--ink);}
::-webkit-scrollbar{width:0;height:0;}

/* ---------- 通用 ---------- */
.page{display:none;padding:20px 22px 110px;animation:fadeIn .28s ease;}
.page.active{display:block;}
@keyframes fadeIn{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:none;}}
.serif{font-family:var(--serif);}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:20px;}
.btn{
  display:block;width:100%;padding:14px;border-radius:14px;text-align:center;
  font-size:16px;letter-spacing:2px;transition:transform .12s ease,opacity .12s;
}
.btn:active{transform:scale(.98);}
.btn-primary{background:var(--ink);color:#faf9f4;}
.btn-accent{background:var(--accent);color:#fff;}
.btn-ghost{border:1px solid var(--line);color:var(--sub);font-size:13px;letter-spacing:1px;padding:10px;border-radius:12px;}
.link-sub{color:var(--faint);font-size:12.5px;text-decoration:underline;text-underline-offset:3px;}
.divider{height:1px;background:var(--line);margin:18px 0;}
.tag{display:inline-block;font-size:11px;color:var(--sub);border:1px solid var(--line);border-radius:99px;padding:1px 10px;letter-spacing:1px;}

/* ---------- 底部导航 ---------- */
#nav{
  --nav-h:64px;
  position:fixed;bottom:0;left:50%;transform:translateX(-50%);
  width:100%;max-width:480px;height:var(--nav-h);
  background:rgba(250,249,244,.94);
  backdrop-filter:blur(10px);border-top:1px solid var(--line);
  display:flex;z-index:40;
  padding-bottom:env(safe-area-inset-bottom);
  box-sizing:border-box;
}
#nav button{
  flex:1;padding:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;
  color:var(--faint);font-size:11px;letter-spacing:1px;transition:color .15s;
}
#nav button svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.5;}
#nav button.on{color:var(--ink);}

/* ---------- 引导层 ---------- */
#onboard{
  position:fixed;inset:0;background:var(--bg);z-index:100;
  display:flex;flex-direction:column;justify-content:center;align-items:center;
  padding:40px 34px;text-align:center;
}
#onboard.hide{display:none;}
#ob-step{width:100%;max-width:340px;}
#ob-step h1{font-family:var(--serif);font-size:34px;letter-spacing:10px;margin:18px 0 10px;text-indent:10px;}
#ob-step .en{font-size:12px;color:var(--faint);letter-spacing:5px;text-transform:uppercase;}
#ob-step p{color:var(--sub);font-size:14.5px;margin:14px 0 6px;}
.field{margin:16px 0;text-align:left;}
.field label{display:block;font-size:13px;color:var(--sub);margin-bottom:7px;letter-spacing:1px;}
.field input,.field textarea{
  width:100%;background:var(--card);border:1px solid var(--line);border-radius:12px;
  padding:12px 14px;outline:none;resize:none;
}
.field input:focus,.field textarea:focus{border-color:var(--faint);}

/* ---------- 今天页 ---------- */
#home-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;}
#home-head .brand{font-family:var(--serif);font-size:20px;letter-spacing:6px;}
#day-hero{text-align:center;padding:34px 0 26px;}
#day-hero .num{font-family:var(--serif);font-size:88px;line-height:1;font-weight:600;}
#day-hero .num small{font-size:26px;color:var(--sub);font-weight:400;}
#day-hero .cap{color:var(--sub);font-size:13px;letter-spacing:3px;margin-top:10px;}
#day-hero .sub{color:var(--faint);font-size:12px;margin-top:4px;letter-spacing:1px;}
#fox-bar{
  display:flex;gap:14px;align-items:flex-start;
  background:var(--accent-soft);border-radius:16px;padding:16px;margin:8px 0 16px;
}
#fox-bar img{width:52px;height:52px;border-radius:50%;background:#fff;border:1px solid var(--line);object-fit:cover;}
#fox-bar .who{font-size:12px;color:var(--accent);letter-spacing:1px;margin-bottom:2px;}
#fox-bar .say{font-size:14px;color:var(--ink);line-height:1.65;}
#check-card{text-align:center;padding:26px 20px;}
#check-btn{padding:15px;border-radius:14px;background:var(--ink);color:#faf9f4;font-size:16px;letter-spacing:4px;width:100%;transition:all .15s;}
#check-btn:disabled{background:transparent;color:var(--sub);border:1.5px dashed var(--line);letter-spacing:2px;}
#relapse-link{margin-top:14px;display:inline-block;}
#check-ripple{position:relative;display:inline-block;}
#milestones{margin-top:16px;}
#milestones .cap{font-size:13px;color:var(--sub);letter-spacing:2px;margin-bottom:12px;}
#ms-track{display:flex;justify-content:space-between;position:relative;margin:0 4px 8px;}
#ms-track::before{content:"";position:absolute;left:0;right:0;top:5px;height:1px;background:var(--line);}
#ms-track .ms{text-align:center;position:relative;z-index:1;width:34px;}
#ms-track .dot{width:11px;height:11px;border-radius:50%;background:var(--bg);border:1.5px solid var(--line);margin:0 auto 5px;}
#ms-track .ms.done .dot{background:var(--ink);border-color:var(--ink);}
#ms-track .ms.next .dot{border-color:var(--accent);background:var(--accent-soft);}
#ms-track .d{font-size:10.5px;color:var(--faint);}
#ms-track .ms.next .d{color:var(--accent);}
#ms-progress{height:3px;background:var(--line);border-radius:2px;overflow:hidden;margin-top:10px;}
#ms-progress i{display:block;height:100%;background:var(--accent);transition:width .6s ease;}
#ms-next-note{font-size:12px;color:var(--sub);margin-top:8px;text-align:center;}
#home-actions{display:flex;gap:12px;margin-top:16px;}
#home-actions .act{
  flex:1;background:var(--card);border:1px solid var(--line);border-radius:16px;
  padding:16px 14px;text-align:center;
}
#home-actions .act:active{transform:scale(.98);}
#home-actions .t{font-size:14px;margin-top:6px;letter-spacing:1px;}
#home-actions .d{font-size:11px;color:var(--faint);margin-top:3px;}
#home-actions svg{width:24px;height:24px;stroke:var(--sub);fill:none;stroke-width:1.4;}

/* ---------- 对话页通用 ---------- */
/* 聊天页用 flex 列布局，让 chat-wrap 自动占满 persona-row 之下到 nav 之上的空间
   避免固定 100dvh - 110px 被 persona-row 顶到 nav 下面 */
#page-guardian, #page-shadow{
  display:none;
  padding:20px 22px 0;
}
#page-guardian.active, #page-shadow.active{
  display:flex;
  flex-direction:column;
  height:calc(100dvh - var(--nav-h,64px) - env(safe-area-inset-bottom));
  min-height:0;
  padding-bottom:8px; /* 让输入框和 nav 之间再留点呼吸感 */
  box-sizing:border-box;
}
/* 让 #shadow-body 作为 flex item 占满剩余空间；
   同时作为 flex 容器，使其内嵌的 .chat-wrap (chat 模式) 用 flex:1 占满 */
#shadow-body{display:flex;flex-direction:column;flex:1;min-height:0;}
.chat-wrap{
  display:flex;flex-direction:column;
  flex:1;min-height:0;
  padding:0 0 6px;
}
.chat-head{
  display:flex;align-items:center;gap:12px;padding:6px 0 14px;border-bottom:1px solid var(--line);margin-bottom:14px;
}
.chat-head img{width:44px;height:44px;border-radius:50%;border:1px solid var(--line);background:#fff;object-fit:cover;}
.chat-head .n{font-family:var(--serif);font-size:17px;letter-spacing:2px;}
.chat-head .s{font-size:11.5px;color:var(--faint);letter-spacing:1px;}
.chat-head .right{margin-left:auto;font-size:11.5px;color:var(--accent);text-align:right;line-height:1.5;}
#chat-scroll{flex:1;overflow-y:auto;padding:4px 2px 12px;display:flex;flex-direction:column;gap:14px;}
.msg{display:flex;gap:10px;max-width:88%;animation:fadeIn .25s ease;}
.msg.ai{align-self:flex-start;}
.msg.me{align-self:flex-end;flex-direction:row-reverse;}
.msg .ava{width:32px;height:32px;border-radius:50%;border:1px solid var(--line);background:#fff;object-fit:cover;flex-shrink:0;margin-top:2px;}
.msg .ava.me-ava{background:var(--ink);color:#faf9f4;display:flex;align-items:center;justify-content:center;font-size:12px;border-color:var(--ink);}
.bubble{padding:10px 14px;border-radius:4px 14px 14px 14px;background:var(--card);border:1px solid var(--line);font-size:14.5px;}
.msg.me .bubble{background:var(--ink);color:#faf9f4;border-color:var(--ink);border-radius:14px 4px 14px 14px;}
.bubble .sys-tip{display:block;font-size:11px;color:var(--faint);margin-top:8px;border-top:1px dashed var(--line);padding-top:6px;}
.msg.sys{align-self:center;max-width:100%;}
.msg.sys .bubble{background:transparent;border:none;color:var(--faint);font-size:12px;text-align:center;padding:0;}
.crisis-card{
  background:#fdf3f0;border:1px solid #e8cfc5;border-radius:14px;padding:14px 16px;font-size:13.5px;color:var(--danger);
  align-self:stretch;animation:fadeIn .3s;
}
.crisis-card b{letter-spacing:1px;}
.typing{display:flex;gap:4px;padding:12px 16px;}
.typing i{width:5px;height:5px;border-radius:50%;background:var(--faint);animation:blink 1.2s infinite;}
.typing i:nth-child(2){animation-delay:.2s;}
.typing i:nth-child(3){animation-delay:.4s;}
@keyframes blink{0%,60%,100%{opacity:.25;}30%{opacity:1;}}
/* 发送区合并成一个框：textarea 右侧留空，发送按钮绝对定位在框内 */
.chat-input{
  position:relative;
  padding-top:12px;border-top:1px solid var(--line);
}
.chat-input textarea{
  width:100%;display:block;background:var(--card);border:1px solid var(--line);border-radius:14px;
  padding:11px 50px 11px 14px;outline:none;resize:none;height:46px;line-height:1.5;
}
.chat-input button{
  position:absolute;right:5px;bottom:5px;
  width:36px;height:36px;border-radius:50%;background:var(--ink);color:#faf9f4;
  display:flex;align-items:center;justify-content:center;
}
.chat-input button svg{width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:1.8;}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px;}
.chips button{
  border:1px solid var(--line);background:var(--card);border-radius:99px;
  padding:7px 15px;font-size:13px;color:var(--sub);
}

/* ---------- 人格选择 ---------- */
#persona-row{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px;margin-bottom:16px;}
#persona-row button{
  flex-shrink:0;border:1px solid var(--line);background:var(--card);border-radius:12px;
  padding:8px 13px;font-size:12.5px;color:var(--sub);line-height:1.4;text-align:left;
}
#persona-row button.on{border-color:var(--ink);color:var(--ink);}
#persona-row button b{display:block;font-size:13px;letter-spacing:1px;}

/* ---------- 影子页 ---------- */
#shadow-intro .art{display:flex;justify-content:center;margin-bottom:18px;}
#shadow-intro .art img{width:110px;height:110px;border-radius:50%;filter:grayscale(1);opacity:.85;border:1px solid var(--line);background:#fff;object-fit:cover;}
#shadow-intro h2{font-family:var(--serif);font-size:22px;letter-spacing:4px;text-align:center;}
#shadow-intro .en{text-align:center;font-size:11px;color:var(--faint);letter-spacing:4px;margin:4px 0 16px;text-transform:uppercase;}
#shadow-intro ul{list-style:none;color:var(--sub);font-size:13.5px;margin:12px 0 4px;}
#shadow-intro ul li{padding-left:16px;position:relative;margin-bottom:6px;}
#shadow-intro ul li::before{content:"·";position:absolute;left:2px;color:var(--accent);}
#shadow-warn{
  background:#fdf3f0;border:1px solid #e8cfc5;border-radius:14px;padding:13px 16px;
  font-size:12.5px;color:var(--danger);line-height:1.8;margin:16px 0;
}
#analyzing{text-align:center;padding:36px 20px;}
#analyzing .spin{width:44px;height:44px;border:2px solid var(--line);border-top-color:var(--ink);border-radius:50%;margin:0 auto 20px;animation:spin 1s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}
#analyzing .step{color:var(--sub);font-size:13.5px;letter-spacing:2px;min-height:24px;}
#session-end{
  position:fixed;inset:0;background:rgba(250,249,244,.98);z-index:90;
  display:none;flex-direction:column;justify-content:center;align-items:center;padding:36px;text-align:center;
}
#session-end.show{display:flex;}
#session-end h3{font-family:var(--serif);font-size:24px;letter-spacing:4px;margin-bottom:14px;}
#session-end p{color:var(--sub);font-size:14px;max-width:300px;}
#session-end .breath{
  width:120px;height:120px;border-radius:50%;border:1px solid var(--line);margin:26px 0;
  display:flex;align-items:center;justify-content:center;color:var(--faint);font-size:12px;letter-spacing:2px;
  animation:breath 8s ease-in-out infinite;
}
@keyframes breath{0%,100%{transform:scale(.88);opacity:.6;}40%{transform:scale(1.08);opacity:1;}}

/* ---------- 弹层 ---------- */
#modal-mask{
  position:fixed;inset:0;background:rgba(38,35,30,.35);z-index:80;display:none;
  align-items:flex-end;justify-content:center;
}
#modal-mask.show{display:flex;}
#modal{
  width:100%;max-width:480px;background:var(--bg);border-radius:22px 22px 0 0;
  padding:24px 24px 34px;max-height:82dvh;overflow-y:auto;animation:slideUp .25s ease;
}
@keyframes slideUp{from{transform:translateY(40px);opacity:.4;}to{transform:none;opacity:1;}}
#modal h3{font-family:var(--serif);font-size:18px;letter-spacing:3px;margin-bottom:14px;}
#modal .close-row{display:flex;justify-content:flex-end;margin-bottom:-14px;}
#modal .close-row button{color:var(--faint);font-size:13px;padding:4px 8px;}
.bottle-item{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px 14px;margin-bottom:10px;font-size:13.5px;}
.bottle-item .t{font-size:11px;color:var(--faint);margin-bottom:4px;letter-spacing:1px;}

/* ---------- 我（个人主页） ---------- */
#page-me{
  display:none;
  padding:52px 22px 18px;position:relative;
  min-height:calc(100dvh - var(--nav-h,64px) - env(safe-area-inset-bottom));
  box-sizing:border-box;
}
#page-me.active{display:block;}
.me-gear{
  position:absolute;top:16px;right:16px;width:34px;height:34px;border-radius:50%;
  background:var(--card);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;
  color:var(--sub);transition:.15s;
}
.me-gear:hover,.me-gear:active{background:var(--bg);color:var(--ink);}
.me-gear svg{width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:1.6;}

.me-head{display:flex;align-items:center;gap:14px;padding:4px 4px 16px;}
.me-ava{
  width:60px;height:60px;border-radius:50%;background:var(--card);
  border:1.5px solid var(--ink);display:flex;align-items:center;justify-content:center;
  font-family:var(--serif);font-size:22px;color:var(--ink);flex-shrink:0;letter-spacing:0;
}
.me-id .name{font-family:var(--serif);font-size:18px;letter-spacing:4px;}
.me-id .sub{font-size:12px;color:var(--faint);margin-top:4px;letter-spacing:2px;}

.me-section{margin-bottom:18px;}
.me-section .sec-cap{font-size:11.5px;color:var(--faint);letter-spacing:3px;margin:0 4px 9px;}

.me-card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:3px 16px;}
.me-card .row{
  display:flex;justify-content:space-between;align-items:center;gap:12px;
  padding:12px 0;border-bottom:1px solid var(--line);min-height:50px;
}
.me-card .row:last-child{border-bottom:none;}
.me-card .row .l{font-size:14px;}
.me-card .row .l small{display:block;font-size:11.5px;color:var(--faint);margin-top:2px;letter-spacing:.5px;}
.me-card .row input[type=date],.me-card .row input[type=text]{
  border:none;background:transparent;text-align:right;outline:none;color:var(--accent);
  font-size:14px;max-width:55%;
}

#persona-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
#persona-grid button{
  background:var(--card);border:1px solid var(--line);border-radius:14px;
  padding:11px 11px;text-align:left;transition:.15s;
}
#persona-grid button.on{border-color:var(--ink);background:#fdfaf3;box-shadow:inset 0 0 0 1px var(--ink);}
#persona-grid b{display:block;font-family:var(--serif);letter-spacing:2px;font-size:14px;}
#persona-grid span{font-size:11px;color:var(--sub);display:block;margin-top:3px;line-height:1.5;}

.me-foot{
  text-align:center;color:var(--faint);font-size:10.5px;letter-spacing:2px;margin-top:24px;
}

/* ---------- 设置弹层（来自原设置页的低频内容） ---------- */
.settings-about{font-size:12.5px;color:var(--sub);line-height:1.9;margin:6px 0 14px;}
.settings-crisis{
  background:#fbf3ee;border:1px solid #ead8cb;border-radius:12px;
  padding:14px 16px;font-size:12.5px;color:#9a5d3a;line-height:1.85;margin-top:6px;
}
.settings-crisis b{color:#7a3a1e;}
.toast{
  position:fixed;bottom:120px;left:50%;transform:translateX(-50%);
  background:var(--ink);color:#faf9f4;font-size:13px;letter-spacing:1px;
  padding:9px 22px;border-radius:99px;z-index:120;animation:fadeIn .2s;pointer-events:none;
}
</style>
</head>
