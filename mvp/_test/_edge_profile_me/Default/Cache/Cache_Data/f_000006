    localStorage.removeItem(LS_KEY);
    S = defaultState(); save();
    closeModal();
    obStep = 0; renderOnboard(); renderHome();
    toast('已清空，重新开始');
  });
  $('#clr-no').addEventListener('click', closeModal);
});
/* 右上角齿轮 → 关于 / 危机帮助 */
