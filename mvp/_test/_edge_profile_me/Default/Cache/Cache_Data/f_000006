var shParsed = null;
function renderShSpeakers(sel){
  var box = $('#sh-speakers');
  if(!box) return;
  if(!shParsed || shParsed.speakers.length<2){ box.style.display='none'; return; }
  box.style.display='block';
  var html = '文件里检测到 '+shParsed.speakers.length+' 位说话人，分析谁的消息？';
  ['全部'].concat(shParsed.speakers).forEach(function(o){
    html += ' <a href="javascript:void(0)" data-sp="'+esc(o)+'" style="margin-right:10px;'+(o===sel?'color:var(--ink);font-weight:600;border-bottom:2px solid var(--ink);':'color:var(--sub);')+'">'+esc(o)+'</a>';
  });
  box.innerHTML = html;
  box.querySelectorAll('a').forEach(function(a){
    a.addEventListener('click', function(){
      var sp = a.getAttribute('data-sp');
      $('#sh-log').value = (sp==='全部' || !shParsed.byName[sp]) ? shParsed.cleaned : shParsed.byName[sp].join('\n');
      renderShSpeakers(sp);
    });
  });
}
function renderShadow(){
  var body = $('#shadow-body');
  if(shadowMode==='setup'){
    body.innerHTML =
      '<div class="card" style="margin-top:8px;">'+
      '<h2 style="font-family:var(--serif);letter-spacing:3px;font-size:19px;">设置影子</h2>'+
      '<p style="color:var(--sub);font-size:13.5px;margin:8px 0 4px;">把和ta的聊天记录给我：可以从微信导出的文件直接导入，也可以复制粘贴（每行一条消息）。我会分析ta的说话习惯，生成一个「影子」。它只存在于你的手机里。</p>'+
      '<div class="field"><label>ta 的代号</label><input type="text" id="sh-name" value="'+esc(S.shadow.name||S.exName||'')+'" placeholder="怎么称呼ta"></div>'+
      '<div class="field"><label>聊天记录</label>'+
      '<div style="display:flex;gap:10px;align-items:center;margin-bottom:8px;">'+
      '<button type="button" class="btn btn-ghost" style="margin:0;padding:8px 16px;font-size:13px;" id="sh-import">从微信导入</button>'+
      '<span id="sh-file" style="font-size:12px;color:var(--faint);">支持 txt / html，不会上传到任何地方</span></div>'+
      '<input type="file" id="sh-file-in" accept=".txt,.html,.htm,.log,.csv" style="display:none;">'+
      '<textarea id="sh-log" rows="7" placeholder="从微信导入，或把聊天记录复制进来，每行一条…"></textarea>'+
      '<div id="sh-speakers" style="display:none;margin-top:10px;font-size:12.5px;line-height:2.2;"></div>'+
      '</div>'+
      '<button class="btn btn-primary" id="sh-go">开始分析</button>'+
      '<button class="btn btn-ghost" style="margin-top:10px;" id="sh-cancel">先不了</button>'+
      '</div>';
    shParsed = null;
    $('#sh-import').addEventListener('click', function(){ $('#sh-file-in').click(); });
    $('#sh-file-in').addEventListener('change', function(){
      var f = this.files && this.files[0];
      if(!f) return;
      var nameEl = $('#sh-file');
      nameEl.textContent = '正在读取 '+f.name+'…';
      var fr = new FileReader();
      fr.onload = function(){
        try{
          var text = decodeChatFile(fr.result);
          var r = parseWeChatLog(text);
          shParsed = r;
          var sel = defaultShadowSpeaker(r);
          var content = sel ? r.byName[sel].join('\n') : r.cleaned;
          $('#sh-log').value = content;
          var cnt = content ? content.split(/\n+/).filter(Boolean).length : 0;
          nameEl.textContent = f.name+' · 读到 '+cnt+' 条消息';
          renderShSpeakers(sel);
          if(content.trim().length<20) toast('这份文件没读到足够的聊天内容，可以直接粘贴');
        }catch(e){
          nameEl.textContent = '读取失败，试试直接粘贴';
        }
      };
      fr.onerror = function(){ nameEl.textContent = '读取失败，试试直接粘贴'; };
      fr.readAsArrayBuffer(f);
      this.value = '';
    });
    $('#sh-go').addEventListener('click', function(){
      var log = $('#sh-log').value.trim();
      var name = $('#sh-name').value.trim() || '影子';
      if(log.length<20){ toast('多粘贴一些聊天记录，至少几行'); return; }
      S.shadow.name = name;
      shadowMode = 'analyze';
      renderShadow();
      var steps = ['正在读取聊天记录…','识别口头禅与语气词…','分析回复节奏…','生成影子…'];
      var i = 0;
      var stepEl = $('#an-step');
      var timer = setInterval(function(){
        i++;
        if(i<steps.length){ stepEl.textContent = steps[i]; }
        else{
          clearInterval(timer);
          S.shadow.profile = analyzeChat(log);
          S.shadow.enabled = true;
          save(); shadowMode='view'; renderShadow();
        }
      }, 700);
    });
    $('#sh-cancel').addEventListener('click', function(){ shadowMode='view'; renderShadow(); });
    return;
  }
  if(shadowMode==='analyze'){
    body.innerHTML =
      '<div class="card" id="analyzing">'+
      '<div class="spin"></div>'+
      '<div class="step" id="an-step">正在读取聊天记录…</div>'+
      '</div>';
    return;
  }
  if(shadowMode==='chat'){
    var remain = shadowRemaining();
    var left = SHADOW_MAX_DAY - shadowSessionsToday();
    body.innerHTML =
      '<div class="chat-wrap">'+
      '<div class="chat-head">'+
      '<img src="assets/agent.png" style="filter:grayscale(1) opacity(.8);" alt="影子">'+
      '<div><div class="n">'+esc(S.shadow.name)+'</div><div class="s">AI 影子 · 非真人</div></div>'+
      '<div class="right">本次剩余 <b id="sh-remain">'+fmtRemain(remain)+'</b><br>今日还剩 '+left+' 次</div>'+
      '</div>'+
      '<div id="s-scroll" style="flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:14px;padding:4px 2px 12px;"></div>'+
      '<div class="chat-input">'+
      '<textarea id="s-input" placeholder="想说的、没说完的，都可以…" rows="1"></textarea>'+
      '<button id="s-send"><svg viewBox="0 0 24 24"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg></button>'+
      '</div>'+
      '</div>';
    var sc = $('#s-scroll');
    sc.innerHTML = S.shadow.msgs.map(msgHtml).join('');
    scrollBottom(sc);
    if(!S.shadow.msgs.length){
      pushS('sys','（这是根据聊天记录生成的 AI 影子，不是真的'+esc(S.shadow.name)+'。它不会主动找你，也不会替ta做任何承诺。）');
      pushS('ai','……嗯。');
    }
    clearInterval(shadowTimer);
    shadowTimer = setInterval(function(){
      var r = shadowRemaining();
      var el = $('#sh-remain');
      if(el) el.textContent = fmtRemain(r);
      if(r<=0) endShadowSession();
    }, 1000);
    $('#s-send').addEventListener('click', function(){
      var v = $('#s-input').value.trim();
      if(!v) return;
      $('#s-input').value='';
      sendShadow(v);
    });
    $('#s-input').addEventListener('keydown', function(e){
      if(e.key==='Enter' && !e.shiftKey){ e.preventDefault(); $('#s-send').click(); }
    });
    return;
  }
  /* view 模式 */
  if(!S.shadow.enabled){
    body.innerHTML =
      '<div class="card" id="shadow-intro" style="margin-top:8px;">'+
      '<div class="art"><img src="assets/agent.png" style="filter:grayscale(1);"></div>'+
      '<h2>影子</h2><div class="en">The Shadow</div>'+
      '<p style="color:var(--sub);font-size:13.5px;line-height:1.9;">实在忍不住想联系的时候，把想说的话说给「影子」——一个根据你们的聊天记录（可从微信直接导入）、模仿ta语气生成的 AI。说完，就放下手机。</p>'+
      '<ul>'+
      '<li>单次对话最长 20 分钟，到时自动结束</li>'+
      '<li>每天最多 3 次，不鼓励常来</li>'+
      '<li>影子不会说「我也想你」「我们复合吧」</li>'+
      '</ul>'+
      '<div id="shadow-warn">这个功能默认关闭，因为它可能延长戒断期。它是「实在忍不住」时的缓冲垫，不是替代品。用完记得去找小白说说话。</div>'+
      '<button class="btn btn-primary" id="sh-start">我理解了，开启影子</button>'+
      '</div>';
    $('#sh-start').addEventListener('click', function(){ shadowMode='setup'; renderShadow(); });
  }else{
    var used = shadowSessionsToday();
    body.innerHTML =
      '<div class="card" style="margin-top:8px;">'+
      '<div style="display:flex;gap:14px;align-items:center;">'+
      '<img src="assets/agent.png" style="width:56px;height:56px;border-radius:50%;filter:grayscale(1);border:1px solid var(--line);object-fit:cover;">'+
      '<div><div style="font-family:var(--serif);letter-spacing:2px;font-size:17px;">'+esc(S.shadow.name)+' · 影子</div>'+
      '<div style="font-size:12px;color:var(--faint);">今日已用 '+used+' / '+SHADOW_MAX_DAY+' 次</div></div>'+
      '</div>'+
      (S.shadow.profile ? '<div class="divider"></div><div style="font-size:12.5px;color:var(--sub);line-height:1.9;">'+profileSummary(S.shadow.profile)+'</div>' : '')+
      '<button class="btn btn-primary" style="margin-top:18px;" id="sh-enter" '+(used>=SHADOW_MAX_DAY?'disabled style="background:var(--line);color:var(--sub);"':'')+'>开始一次对话</button>'+
      (used>=SHADOW_MAX_DAY?'<p style="text-align:center;font-size:12.5px;color:var(--sub);margin-top:10px;">今天影子时间用完了。想说的话，留给小白吧。</p>':'')+
      '<button class="btn btn-ghost" style="margin-top:10px;" id="sh-reset">重新设置 / 关闭影子</button>'+
      '</div>';
    if(used<SHADOW_MAX_DAY){
      $('#sh-enter').addEventListener('click', function(){
        S.shadow.sessionsToday = used+1;
        S.shadow.sessionStart = Date.now();
        S.shadow.msgs = [];
        save();
        shadowMode='chat'; renderShadow();
      });
    }
    $('#sh-reset').addEventListener('click', function(){
      openModal(
        '<h3>关闭影子？</h3>'+
        '<p style="color:var(--sub);font-size:14px;margin-bottom:18px;">已有的影子资料和记录会被删除。</p>'+
        '<button class="btn btn-primary" id="sh-off" style="margin-bottom:10px;">删除影子</button>'+
        '<button class="btn btn-ghost" id="sh-keep">先留着</button>'
      );
      $('#sh-off').addEventListener('click', function(){
        S.shadow = defaultState().shadow;
        save(); closeModal(); shadowMode='view'; renderShadow();
      });
      $('#sh-keep').addEventListener('click', closeModal);
    });
  }
}
function pushS(role, text, tip){
  S.shadow.msgs.push({role:role, text:text, tip:tip, t:Date.now()});
  save();
  var sc = $('#s-scroll');
  if(sc){
    sc.insertAdjacentHTML('beforeend', msgHtml(S.shadow.msgs[S.shadow.msgs.length-1]));
    scrollBottom(sc);
  }
}
var shadowUserCount = 0;
function sendShadow(text){
  if(!text) return;
  pushS('me', text);
  shadowUserCount++;
  var sc = $('#s-scroll');
  var t = document.createElement('div');
  t.className='msg ai';
  t.innerHTML = '<img class="ava" src="assets/agent.png" style="filter:grayscale(1);"><div class="bubble typing"><i></i><i></i><i></i></div>';
  sc.appendChild(t); scrollBottom(sc);
  var crisis = detectIntent(text)==='crisis';
  setTimeout(function(){
    t.remove();
    if(crisis){
      pushS('ai', CRISIS_TEXT);
      var card = document.createElement('div');
      card.className='crisis-card';
      card.innerHTML = '<b>请让真实的人现在陪着你</b><br><br>· 全国 24 小时心理援助热线：<b>400-161-9995</b><br>· 紧急情况请拨打 <b>120 / 110</b><br><br>影子接不住这么重的痛苦。但小白在乎你，你身边的人也在。';
      sc.appendChild(card); scrollBottom(sc);
      return;
    }
    var tip = (shadowUserCount%3===0) ? '提醒：这是AI生成的影子，不是真的ta。' : null;
    pushS('ai', shadowReply(text), tip);
  }, 800+Math.random()*900);
}
function endShadowSession(){
  clearInterval(shadowTimer);
  S.shadow.sessionStart = 0;
  save();
  shadowMode = 'view';
  $('#session-end').classList.add('show');
}
$('#end-to-guardian').addEventListener('click', function(){
  $('#session-end').classList.remove('show');
  nav('guardian');
  sendGuardian('我刚和影子说完话。');
});
$('#end-close').addEventListener('click', function(){
  $('#session-end').classList.remove('show');
  renderShadow();
});

/* ================================================================
   我（个人主页）
================================================================ */
function renderMe(){
  var day = dayNum();
  $('#me-ava-num').textContent = day;
  $('#me-sub').textContent = '已坚持 ' + day + ' 天';
  $('#set-start').value = S.startDate;
  $('#set-exname').value = S.exName;
  var grid = $('#persona-grid'); grid.innerHTML='';
  Object.keys(PERSONAS).forEach(function(k){
    var b = document.createElement('button');
    if(S.persona===k) b.classList.add('on');
    b.innerHTML = '<b>'+PERSONAS[k].name+'</b><span>'+PERSONAS[k].desc+'</span>';
    b.addEventListener('click', function(){ S.persona=k; save(); renderMe(); });
    grid.appendChild(b);
  });
}
$('#set-start').addEventListener('change', function(){
  if(this.value){ S.startDate=this.value; save(); toast('已更新'); renderHome(); renderMe(); }
});
$('#set-exname').addEventListener('change', function(){
  S.exName = this.value.trim(); save();
});
$('#set-export').addEventListener('click', function(){
  var blob = new Blob([JSON.stringify(S,null,2)], {type:'application/json'});
  var a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'liubai-backup-'+todayStr()+'.json';
  a.click();
});
$('#set-clear').addEventListener('click', function(){
  openModal(
    '<h3>清空所有数据？</h3>'+
