<script>
/* ================================================================
   留白 Whitespace MVP · 纯前端原型
   数据：localStorage；对话：本地规则引擎
================================================================ */
'use strict';
var $ = function(s){ return document.querySelector(s); };
var $$ = function(s){ return document.querySelectorAll(s); };
var LS_KEY = 'liubai_mvp_v1';
var MS_LIST = [
  {d:1,  n:'起步'},{d:3,  n:'初雪'},{d:7,  n:'一周'},{d:21, n:'习惯'},
  {d:30, n:'满月'},{d:60, n:'双月'},{d:90, n:'一季'},{d:180,n:'半年'},{d:365,n:'一年'}
];

/* ---------- 状态 ---------- */
function defaultState(){
  return {
    onboarded:false,
    startDate: todayStr(),
    exName:'',
    lastCheckIn:'',
    checkCount:0,
    relapses:0,
    persona:'warm',
    gMsgs:[],
    shadow:{
      enabled:false, name:'', profile:null, msgs:[],
      sessionsDate:'', sessionsToday:0, sessionStart:0
    },
    bottle:[]
  };
}
function load(){
  try{
    var raw = localStorage.getItem(LS_KEY);
    if(!raw) return defaultState();
    var s = JSON.parse(raw);
    var d = defaultState();
    for(var k in d){ if(s[k]===undefined) s[k]=d[k]; }
    return s;
  }catch(e){ return defaultState(); }
}
function save(){ try{ localStorage.setItem(LS_KEY, JSON.stringify(S)); }catch(e){} }
var S = load();

/* ---------- 工具 ---------- */
function todayStr(){
  var d = new Date();
  return d.getFullYear()+'-'+('0'+(d.getMonth()+1)).slice(-2)+'-'+('0'+d.getDate()).slice(-2);
}
function dayNum(){
  var a = new Date(S.startDate+'T00:00:00');
  var b = new Date(todayStr()+'T00:00:00');
  return Math.max(1, Math.floor((b-a)/86400000)+1);
}
function pick(arr){ return arr[Math.floor(Math.random()*arr.length)]; }
function esc(s){
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
function toast(t){
  var el = document.createElement('div');
  el.className='toast'; el.textContent=t;
  document.body.appendChild(el);
  setTimeout(function(){ el.remove(); }, 2000);
}
function fmtDate(ds){
  var p = ds.split('-');
  return p[0]+' 年 '+parseInt(p[1],10)+' 月 '+parseInt(p[2],10)+' 日';
}

/* ---------- 路由 ---------- */
function nav(page){
  $$('.page').forEach(function(p){ p.classList.remove('active'); });
  $('#page-'+page).classList.add('active');
  $$('#nav button').forEach(function(b){
    b.classList.toggle('on', b.getAttribute('data-page')===page);
  });
  if(page==='home') renderHome();
  if(page==='guardian') renderGuardian();
  if(page==='shadow') renderShadow();
  if(page==='me') renderMe();
}
$$('#nav button').forEach(function(b){
  b.addEventListener('click', function(){ nav(b.getAttribute('data-page')); });
});

/* ================================================================
   引导流程
================================================================ */
var obStep = 0;
function renderOnboard(){
  var el = $('#ob-step');
  if(S.onboarded){ $('#onboard').classList.add('hide'); return; }
  $('#onboard').classList.remove('hide');
  if(obStep===0){
    el.innerHTML =
      '<div style="display:flex;justify-content:center;"><img src="assets/appicon.png" style="width:96px;height:96px;border-radius:24px;border:1px solid var(--line);"></div>'+
      '<h1>留白</h1>'+
      '<div class="en">Whitespace</div>'+
      '<p>把想念留白，把自己找回。<br>戒断期的每一夜，都有一个安静的存在陪你。</p>'+
      '<button class="btn btn-primary" style="margin-top:28px;" id="ob-next">开始</button>';
    $('#ob-next').addEventListener('click', function(){ obStep=1; renderOnboard(); });
  }else if(obStep===1){
    el.innerHTML =
      '<h1 style="font-size:24px;letter-spacing:4px;text-indent:4px;">先立一个起点</h1>'+
      '<p>你决定不再联系，是从哪一天开始的？</p>'+
      '<div class="field"><label>戒断开始日</label><input type="date" id="ob-date" value="'+todayStr()+'"></div>'+
      '<div class="field"><label>ta 的代号（可选，只存在你的手机里）</label><input type="text" id="ob-ex" placeholder="比如：H、那个人、不用名字"></div>'+
      '<button class="btn btn-primary" id="ob-next2">好，就从这里</button>';
    $('#ob-next2').addEventListener('click', function(){
      var d = $('#ob-date').value || todayStr();
      S.startDate = d;
      S.exName = $('#ob-ex').value.trim();
      obStep = 2; renderOnboard();
    });
  }else{
    el.innerHTML =
      '<div style="display:flex;justify-content:center;"><img src="assets/agent.png" style="width:110px;height:110px;border-radius:50%;border:1px solid var(--line);background:#fff;object-fit:cover;"></div>'+
      '<h1 style="font-size:26px;letter-spacing:6px;text-indent:6px;">我是小白</h1>'+
      '<p>一只蜷成一团的黑狐狸。<br>你不用对我坚强，也不用解释什么。<br>想说话的时候来找我，不想说话的时候，我就在。</p>'+
      '<button class="btn btn-primary" style="margin-top:26px;" id="ob-done">进入留白</button>';
    $('#ob-done').addEventListener('click', function(){
      S.onboarded = true; save(); renderOnboard(); renderHome();
    });
  }
}

/* ================================================================
   今天页
================================================================ */
function foxQuote(){
  var h = new Date().getHours();
  var d = dayNum();
  if(d===1 && S.relapses>0) return '没关系。第 1 天，重新来。你不是从零开始，是从经验开始。';
  if(h>=6&&h<11)  return pick(['早上好。新的一天还没有被任何情绪占用。','晨光是最好 reset。先喝口水，我们慢慢来。']);
  if(h>=11&&h<14) return pick(['中午了，记得吃点热的东西。胃暖了，心会跟着暖一点。','再难的日子也要好好吃饭。']);
  if(h>=14&&h<18) return pick(['下午的光最适合发呆。走神不算浪费。','撑到现在，已经很了不起了。']);
  if(h>=18&&h<23) return pick(['夜晚会放大情绪。别太相信夜里做出的任何决定。','晚上了。难过的话，先来找我，别去找聊天框。']);
  return pick(['这么晚还醒着。没关系，我陪你坐一会儿。','凌晨的心事最重。说出来，会轻一点。']);
}
function renderHome(){
  var d = dayNum();
  $('#day-num').textContent = d;
  $('#day-sub').textContent = '始于 ' + fmtDate(S.startDate) + (S.relapses>0 ? ' · 重新开始过 '+S.relapses+' 次，都算数' : '');
  $('#head-tag').textContent = '不联系的第 ' + d + ' 天';
  $('#fox-say').textContent = foxQuote();
  $('#bottle-count').textContent = S.bottle.length ? '存着 '+S.bottle.length+' 句没寄出的话' : '还没有存下的话';

  var checked = S.lastCheckIn === todayStr();
  var btn = $('#check-btn');
  btn.disabled = checked;
  btn.textContent = checked ? '今 天 已 安 住' : '今 天 ， 我 没 有 联 系';

  /* 里程碑 */
  var track = $('#ms-track'); track.innerHTML='';
  var nextMs = null;
  MS_LIST.forEach(function(m){
    var div = document.createElement('div');
    var cls = 'ms';
    if(d >= m.d) cls += ' done';
    else if(!nextMs){ cls += ' next'; nextMs = m; }
    div.className = cls;
    div.innerHTML = '<div class="dot"></div><div class="d">'+m.d+'<br>'+m.n+'</div>';
    track.appendChild(div);
  });
  var prev = 0;
  for(var i=0;i<MS_LIST.length;i++){ if(MS_LIST[i].d < d) prev = MS_LIST[i].d; }
  var pct = nextMs ? Math.min(100, (d-prev)/(nextMs.d-prev)*100) : 100;
  $('#ms-progress i').style.width = pct+'%';
  $('#ms-next-note').textContent = nextMs
    ? '距离「'+nextMs.n+'」('+nextMs.d+'天) 还有 '+(nextMs.d-d)+' 天'
    : '你已经走完了所有刻度。剩下的路，是你自己的了。';
}

/* 打卡 */
var ENCOURAGE = {
  1:'今天是你新生活的第一天。',
  3:'三天了。身体还记得 ta，脑子也开始学着放下了。',
  7:'一周。从「忍住」变成了「可以」。',
  21:'21 天，一个习惯的形状。接下来的日子，会越来越像你本来的样子。'
};
$('#check-btn').addEventListener('click', function(){
  if(S.lastCheckIn === todayStr()) return;
  S.lastCheckIn = todayStr();
  S.checkCount++;
  save();
  var d = dayNum();
  var enc = ENCOURAGE[d];
  if(enc){
    toast('安住今天 · 第 '+d+' 天');
    showEncourage(d, enc);
  }else{
    toast('安住今天 · 第 '+d+' 天');
  }
  renderHome();
});
function showEncourage(d, msg){
  S.gMsgs.push({ role:'sys', text:'· 第 '+d+' 天 ·\n'+msg });
  save();
  if($('#page-guardian').classList.contains('on')) renderGuardian();
}

/* 没忍住 */
$('#relapse-link').addEventListener('click', function(){
